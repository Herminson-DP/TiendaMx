<%- include('header') %>

<main class="flex-1 py-6 sm:py-10 bg-slate-900/5 min-h-[85vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb & Header -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
            <div>
                <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
                    <a href="/" class="hover:text-blue-600 transition flex items-center gap-1">
                        <span>🏠</span> Inicio
                    </a>
                    <span>/</span>
                    <a href="/perfil" class="hover:text-blue-600 transition">Mi Cuenta</a>
                    <span>/</span>
                    <span class="text-slate-900 font-bold">Historial de Pedidos</span>
                </div>
                <h1 class="text-2xl font-display font-black text-slate-900 flex items-center gap-2">
                    <span>📦</span> Mis Pedidos de Autopartes
                </h1>
                <p class="text-xs text-slate-500 mt-0.5">Seguimiento en tiempo real y registro histórico de tus compras en AutoHub.</p>
            </div>

            <div class="flex items-center gap-2">
                <a href="/autopartes" class="px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition shadow-lg shadow-blue-600/30">
                    <span>🛒</span> Comprar Más Repuestos
                </a>
            </div>
        </div>

        <% if (!orders || orders.length === 0) { %>
            <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center shadow-sm">
                <span class="text-5xl block mb-4">📦</span>
                <h2 class="text-lg font-display font-black text-slate-900">Aún no tienes pedidos registrados</h2>
                <p class="text-xs text-slate-500 max-w-md mx-auto mt-1 mb-6">Explora nuestro catálogo de repuestos garantizados con compatibilidad por VIN para realizar tu primera orden.</p>
                <a href="/autopartes" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white text-xs font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-600/30">
                    <span>⚙️</span> Ver Catálogo de Autopartes
                </a>
            </div>
        <% } else { %>
            <div class="space-y-4">
                <% orders.forEach(order => { %>
                    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm hover:border-blue-400 transition space-y-4">
                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                            <div>
                                <div class="flex items-center gap-2.5">
                                    <h3 class="font-display font-black text-slate-900 text-base">Orden #<%= order.id %></h3>
                                    <span class="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full <%= order.status.includes('Entregado') ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800' %>">
                                        ● <%= order.status || 'Confirmado' %>
                                    </span>
                                </div>
                                <p class="text-xs text-slate-500 font-mono mt-1">
                                    Fecha: <%= order.date %> • Guía de Despacho: <strong class="text-blue-600 font-bold"><%= order.trackingNumber || 'AUTOHUB-COL-8829' %></strong>
                                </p>
                            </div>

                            <div class="text-left sm:text-right">
                                <span class="text-[10px] font-bold text-slate-400 uppercase block">Total Pagado:</span>
                                <span class="text-lg font-display font-black text-slate-900"><%= formatCOP(order.total) %></span>
                            </div>
                        </div>

                        <!-- Products in Order -->
                        <div class="space-y-2">
                            <span class="text-[10px] font-bold uppercase text-slate-400">Detalle de Repuestos:</span>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                                <% order.items.forEach(item => { %>
                                    <div class="p-3 bg-slate-50 rounded-2xl border border-slate-200 flex items-center justify-between text-xs">
                                        <div>
                                            <span class="font-bold text-slate-900 block"><%= (item.part && item.part.name) || (item.product && item.product.name) || 'Autoparte OEM' %></span>
                                            <span class="text-[10px] text-slate-400 font-mono">Cantidad: <%= item.quantity %></span>
                                        </div>
                                        <span class="font-mono font-bold text-slate-900"><%= formatCOP(item.totalCOP || item.total) %></span>
                                    </div>
                                <% }) %>
                            </div>
                        </div>

                        <!-- Customer and Delivery Meta -->
                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-2 text-xs text-slate-600 border-t border-slate-100">
                            <div>
                                <span>Destino: <strong><%= order.customer ? order.customer.address : 'Bogotá D.C.' %></strong></span>
                                <span class="text-slate-400 mx-1.5">•</span>
                                <span>Pago: <strong><%= order.paymentMethod || 'PSE' %></strong></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <a href="/perfil" class="text-xs font-bold text-blue-600 hover:text-blue-700">
                                    Ver en Mi Perfil &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>

    </div>
</main>

<%- include('footer') %>
