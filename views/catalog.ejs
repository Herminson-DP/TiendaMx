<%- include('header') %>

<!-- Hero Promotional Banner -->
<section class="hero-banner" id="heroBanner">
    <div>
        <div class="hero-tag">
            <span>🔥</span> Super Ofertas Colombia 2026
        </div>
        <h1 class="hero-title">
            Tecnología, Audio y Moda al <span>Mejor Precio en COP</span>
        </h1>
        <p class="hero-desc">
            Descubre nuestra selección exclusiva con envíos express a toda Colombia, pagos 100% seguros con PSE, Nequi y Daviplata, y garantía directa de satisfacción.
        </p>
        <div class="hero-buttons">
            <a href="#catalogo" class="btn btn-accent btn-lg" id="btnExplore">
                🛍️ Explorar Catálogo
            </a>
            <div class="hero-coupon-pill">
                <span>🏷️ Cupón 10% OFF:</span>
                <strong class="btn-copy-code" data-code="BIENVENIDO10" title="Haz clic para copiar el cupón">BIENVENIDO10</strong>
            </div>
        </div>
    </div>
    <div class="hero-visual">
        <div class="hero-img-box">
            <img 
                src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&auto=format&fit=crop&q=80" 
                alt="Sony WH-1000XM5 Oferta"
                loading="lazy"
            >
        </div>
    </div>
</section>

<!-- Trust & Value Pillars (4 distinct colorful cards) -->
<section class="features-bar" aria-label="Beneficios de compra">
    <div class="feature-item feature-blue">
        <div class="feature-icon">🚚</div>
        <div class="feature-text">
            <h4>Envío Gratis Nacional</h4>
            <p>En compras superiores a <%= formatMoney(config.free_shipping_threshold || 200000) %> COP</p>
        </div>
    </div>

    <div class="feature-item feature-green">
        <div class="feature-icon">🔒</div>
        <div class="feature-text">
            <h4>Pagos 100% Seguros</h4>
            <p>PSE, Nequi, Daviplata y Tarjetas de Crédito</p>
        </div>
    </div>

    <div class="feature-item feature-purple">
        <div class="feature-icon">🛡️</div>
        <div class="feature-text">
            <h4>Garantía de 30 Días</h4>
            <p>Devolución fácil y respaldo total en cada producto</p>
        </div>
    </div>

    <div class="feature-item feature-amber">
        <div class="feature-icon">⚡</div>
        <div class="feature-text">
            <h4>Entrega Express</h4>
            <p>Despacho en 24 a 48 horas en principales ciudades</p>
        </div>
    </div>
</section>

<!-- Categories Navigation Bar -->
<section id="catalogo" style="margin-bottom: 24px;">
    <div class="categories-nav" role="tablist">
        <a 
            href="/index.php" 
            class="category-pill <%= (!selectedCategory || selectedCategory === '') ? 'active' : '' %>"
            id="catAll"
        >
            <span>✨ Todos los Productos</span>
            <span class="category-count"><%= totalProductsCount %></span>
        </a>

        <% categories.forEach(cat => { %>
            <a 
                href="/index.php?category=<%= encodeURIComponent(cat) %><%= search ? `&search=${encodeURIComponent(search)}` : '' %>" 
                class="category-pill <%= selectedCategory.toLowerCase() === cat.toLowerCase() ? 'active' : '' %>"
            >
                <span><%= cat %></span>
                <span class="category-count"><%= categoryCounts[cat] || 0 %></span>
            </a>
        <% }); %>
    </div>

    <!-- Filter & Toolbar Card -->
    <div class="filter-card">
        <form action="/index.php" method="GET" class="filter-form" id="filterForm">
            <% if (selectedCategory) { %>
                <input type="hidden" name="category" value="<%= selectedCategory %>">
            <% } %>
            <% if (search) { %>
                <input type="hidden" name="search" value="<%= search %>">
            <% } %>

            <!-- Sort By Select -->
            <div class="filter-group">
                <label for="sortSelect" class="filter-label">Ordenar por:</label>
                <select name="sort" id="sortSelect" class="filter-select" onchange="this.form.submit()">
                    <option value="featured" <%= sort === 'featured' ? 'selected' : '' %>>⭐ Destacados / Relevancia</option>
                    <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>💵 Menor Precio a Mayor</option>
                    <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>💎 Mayor Precio a Menor</option>
                    <option value="discount" <%= sort === 'discount' ? 'selected' : '' %>>🔥 Mayores Descuentos</option>
                    <option value="rating" <%= sort === 'rating' ? 'selected' : '' %>>🌟 Mejor Calificados</option>
                    <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>✨ Más Recientes</option>
                </select>
            </div>

            <!-- Price Range Filter -->
            <div class="filter-group">
                <span class="filter-label">Rango de Precio ($ COP):</span>
                <div class="price-inputs">
                    <input 
                        type="number" 
                        name="min_price" 
                        placeholder="Mín" 
                        value="<%= minPrice %>" 
                        class="filter-input"
                        step="10000"
                    >
                    <span style="color: var(--text-muted);">-</span>
                    <input 
                        type="number" 
                        name="max_price" 
                        placeholder="Máx" 
                        value="<%= maxPrice %>" 
                        class="filter-input"
                        step="10000"
                    >
                </div>
            </div>

            <!-- In Stock Checkbox -->
            <div class="filter-group">
                <label class="checkbox-label">
                    <input 
                        type="checkbox" 
                        name="in_stock" 
                        value="1" 
                        <%= inStock ? 'checked' : '' %>
                        onchange="this.form.submit()"
                    >
                    <span>Solo en Stock</span>
                </label>
            </div>

            <div class="filter-group">
                <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
                <% if (selectedCategory || search || sort !== 'featured' || minPrice || maxPrice || inStock) { %>
                    <a href="/index.php" class="btn btn-secondary btn-sm" title="Limpiar todos los filtros">✕ Limpiar</a>
                <% } %>
            </div>
        </form>
    </div>
</section>

<!-- Active Search / Filter Status Banner -->
<% if (search || selectedCategory) { %>
    <div class="flex-between" style="margin-bottom: 24px; background: white; padding: 14px 20px; border-radius: 12px; border: 1px solid var(--border);">
        <div>
            Mostrando resultados para: 
            <% if (selectedCategory) { %>
                <strong style="color: var(--primary);"><%= selectedCategory %></strong>
            <% } %>
            <% if (search) { %>
                <% if (selectedCategory) { %> en <% } %>
                "<strong><%= search %></strong>"
            <% } %>
            (<%= products.length %> <%= products.length === 1 ? 'producto encontrado' : 'productos encontrados' %>)
        </div>
        <a href="/index.php" style="color: var(--primary); font-size: 0.88rem; font-weight: 700;">Ver todo el catálogo &rarr;</a>
    </div>
<% } %>

<!-- Products Grid -->
<% if (!products || products.length === 0) { %>
    <div style="text-align: center; padding: 64px 20px; background: white; border-radius: 16px; border: 1px solid var(--border); margin-bottom: 48px;">
        <div style="font-size: 3.5rem; margin-bottom: 16px;">🔍</div>
        <h3>No se encontraron productos con los criterios seleccionados</h3>
        <p style="color: var(--text-muted); margin: 8px 0 24px;">Intenta ajustando el término de búsqueda o eliminando los filtros de precio y categoría.</p>
        <a href="/index.php" class="btn btn-primary">Ver Todos los Productos</a>
    </div>
<% } else { %>
    <section class="products-grid" aria-label="Catálogo de productos">
        <% products.forEach(product => { %>
            <% 
                const discount = Number(product.discount) || 0;
                const finalPrice = product.price * (1 - discount / 100);
                const isWishlisted = wishlist && wishlist.includes(product.id);
                const stock = product.stock !== undefined ? product.stock : 10;
            %>
            <article class="product-card" id="product-card-<%= product.id %>">
                <!-- Badges -->
                <div class="card-badges">
                    <% if (discount > 0) { %>
                        <span class="badge-tag badge-discount">-<%= discount %>% OFF</span>
                    <% } %>
                    <% if (product.badge) { %>
                        <% 
                            let badgeClass = 'badge-custom';
                            if (product.badge === 'Más Vendido') badgeClass = 'badge-gold';
                            else if (product.badge === 'Oferta') badgeClass = 'badge-discount';
                            else if (product.badge === 'Nuevo') badgeClass = 'badge-emerald';
                            else if (product.badge === 'Pro' || product.badge === 'Premium') badgeClass = 'badge-cyan';
                        %>
                        <span class="badge-tag <%= badgeClass %>"><%= product.badge %></span>
                    <% } %>
                </div>

                <!-- Wishlist Toggle Button -->
                <form action="/index.php?action=toggle-wishlist" method="POST" style="margin: 0;">
                    <input type="hidden" name="product_id" value="<%= product.id %>">
                    <button 
                        type="submit" 
                        class="btn-wishlist <%= isWishlisted ? 'active' : '' %>" 
                        title="<%= isWishlisted ? 'Eliminar de favoritos' : 'Guardar en favoritos' %>"
                    >
                        <%= isWishlisted ? '❤️' : '🤍' %>
                    </button>
                </form>

                <!-- Image link -->
                <a href="/index.php?action=product&id=<%= product.id %>" class="card-img-wrapper">
                    <img 
                        src="<%= product.image %>" 
                        alt="<%= product.name %>"
                        loading="lazy"
                        onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop&q=80'"
                    >
                </a>

                <!-- Card Content -->
                <div class="card-body">
                    <div class="card-category"><%= product.category %></div>
                    
                    <a href="/index.php?action=product&id=<%= product.id %>">
                        <h3 class="card-title"><%= product.name %></h3>
                    </a>

                    <!-- Rating -->
                    <div class="card-rating">
                        <span class="stars">★★★★★</span>
                        <span><%= Number(product.rating || 4.8).toFixed(1) %></span>
                        <span style="color: var(--text-light); font-size: 0.78rem;">(<%= product.reviewsCount || 25 %>)</span>
                    </div>

                    <!-- Description excerpt -->
                    <p class="card-desc"><%= product.description %></p>

                    <!-- Price -->
                    <div class="card-price-row">
                        <span class="price-main"><%= formatMoney(finalPrice) %></span>
                        <% if (discount > 0) { %>
                            <span class="price-old"><%= formatMoney(product.price) %></span>
                            <span class="price-saving">Ahorras <%= formatMoney(product.price - finalPrice) %></span>
                        <% } %>
                    </div>

                    <!-- Stock Status -->
                    <div class="card-stock">
                        <% if (stock <= 0) { %>
                            <span class="stock-out">● Agotado</span>
                        <% } else if (stock <= 5) { %>
                            <span class="stock-low">⚠️ ¡Últimas <%= stock %> unidades disponibles!</span>
                        <% } else { %>
                            <span class="stock-in">✓ En Stock (<%= stock %> unid.)</span>
                        <% } %>
                    </div>

                    <!-- Actions -->
                    <div class="card-actions">
                        <% if (stock > 0) { %>
                            <form action="/index.php?action=add-to-cart" method="POST" style="margin: 0; display: contents;">
                                <input type="hidden" name="product_id" value="<%= product.id %>">
                                <input type="hidden" name="quantity" value="1">
                                <input type="hidden" name="return_url" value="/index.php?action=cart">
                                <button type="submit" class="btn btn-primary btn-block">
                                    🛒 Comprar Ahora
                                </button>
                            </form>
                        <% } else { %>
                            <button type="button" class="btn btn-secondary btn-block" disabled style="opacity: 0.6; cursor: not-allowed;">
                                Agotado
                            </button>
                        <% } %>
                        <a href="/index.php?action=product&id=<%= product.id %>" class="btn btn-secondary" title="Ver ficha técnica y detalles">
                            👁️
                        </a>
                    </div>
                </div>
            </article>
        <% }); %>
    </section>
<% } %>

<%- include('footer') %>
