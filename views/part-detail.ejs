<script>
    const PART_UNIT_PRICE = <%= part.price_cop %>;

    function syncDirectBuyQty(qtyVal) {
        const qty = parseInt(qtyVal, 10) || 1;
        document.getElementById('modalHiddenQty').value = qty;
        document.getElementById('modalDisplayQty').textContent = qty;
        const cartAddHidden = document.getElementById('cartAddHiddenQty');
        if (cartAddHidden) cartAddHidden.value = qty;

        const subtotal = PART_UNIT_PRICE * qty;
        const shipping = subtotal >= 200000 ? 0 : 18000;
        const total = subtotal + shipping;
        
        const totalFormatted = '$' + total.toLocaleString('es-CO') + ' COP' + (shipping === 0 ? ' (Envío Gratis)' : '');
        document.getElementById('modalDisplayTotal').textContent = totalFormatted;
    }

    function openPartDirectBuyModal(specificMethod) {
        if (!window.IS_USER_LOGGED_IN) {
            showAuthRequiredModal(window.location.pathname, 'Para comprar este repuesto debes registrarte si no estás registrado o iniciar sesión si ya tienes cuenta.');
            return;
        }
        const qtySelect = document.getElementById('partDetailQtySelect');
        if (qtySelect) {
            syncDirectBuyQty(qtySelect.value);
        }
        document.getElementById('partDirectModal').classList.remove('hidden');
        if (specificMethod) {
            switchModalPaymentMethod(specificMethod);
        }
    }

    function closePartDirectBuyModal() {
        document.getElementById('partDirectModal').classList.add('hidden');
    }

    function switchModalPaymentMethod(methodKey) {
        const boxes = document.querySelectorAll('.modal-fields-box');
        boxes.forEach(b => b.classList.add('hidden'));

        const target = document.getElementById('modal-field-' + methodKey);
        if (target) {
            target.classList.remove('hidden');
        }

        const cards = document.querySelectorAll('.modal-pm-card');
        cards.forEach(c => {
            const input = c.querySelector('input[type="radio"]');
            if (input && input.value === methodKey) {
                input.checked = true;
                c.classList.add('border-brand-500', 'bg-brand-50/60');
                c.classList.remove('border-slate-200');
            } else {
                c.classList.remove('border-brand-500', 'bg-brand-50/60');
                c.classList.add('border-slate-200');
            }
        });
    }

    function updateModalPseBank(bankName) {
        const nameEl = document.getElementById('modalPseBankName');
        const msgEl = document.getElementById('modalPseBankMsg');
        if (!nameEl || !msgEl) return;

        nameEl.textContent = bankName + ':';
        const msgs = {
            'Bancolombia': 'Ten a la mano tu Clave Dinámica o App Bancolombia para autorizar el débito.',
            'Banco de Bogotá': 'Ingresa con tu clave segura o genera tu Token Digital en la App Móvil.',
            'Davivienda': 'Ten listo tu documento y tu clave virtual de Davivienda.',
            'BBVA Colombia': 'Valida tu ingreso con Token BBVA desde la aplicación BBVA Móvil.',
            'Banco de Occidente': 'Se solicitará tu clave de Banca Móvil y código OTP.',
            'Nu Colombia (Nubank)': 'Se generará la orden de débito directo Nu con confirmación en la app de Nu.',
            'Nequi': 'Usa tu número celular Nequi y confirma la notificación push de pago.',
            'Daviplata': 'Ingresa tu número de celular y confirma el código SMS de Daviplata.'
        };
        msgEl.textContent = msgs[bankName] || 'Serás dirigido a la plataforma segura de ' + bankName + ' con cifrado bancario de 256 bits.';
    }

    function detectModalCardBrand(number) {
        const clean = number.replace(/\s+/g, '');
        const badge = document.getElementById('modalCardBadge');
        if (!badge) return;

        if (/^4/.test(clean)) {
            badge.textContent = 'Visa Débito/Crédito';
        } else if (/^5[1-5]/.test(clean)) {
            badge.textContent = 'MasterCard';
        } else if (/^3[47]/.test(clean)) {
            badge.textContent = 'American Express';
        } else {
            badge.textContent = 'Visa / MasterCard / Amex';
        }
    }
</script>

