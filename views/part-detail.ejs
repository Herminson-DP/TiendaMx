                <!-- 3. Card Box -->
                <div id="modal-field-card" class="modal-fields-box bg-slate-50 rounded-2xl p-4 border border-slate-200 space-y-3 hidden">
                    <div class="flex items-center justify-between pb-1.5 border-b border-slate-200">
