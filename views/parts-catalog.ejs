<script>
    let currentPartPrice = 0;

    function openCatalogBuyModal(partId, name, brand, sku, priceCop, image) {
        if (!window.IS_USER_LOGGED_IN) {
            showAuthRequiredModal('/autopartes/' + partId, 'Para comprar este repuesto debes registrarte si no estás registrado o iniciar sesión si ya tienes cuenta.');
            return;
        }
        currentPartPrice = priceCop;
        document.getElementById('catModalPartId').value = partId;
        document.getElementById('catModalName').textContent = name;
        document.getElementById('catModalSkuBrand').textContent = 'SKU: ' + sku + ' • ' + brand;
        document.getElementById('catModalImg').src = image;
        document.getElementById('catModalQtySelect').value = '1';
        
        updateCatModalQty(1);
        document.getElementById('catalogDirectModal').classList.remove('hidden');
    }

    function closeCatalogBuyModal() {
        document.getElementById('catalogDirectModal').classList.add('hidden');
    }

    function updateCatModalQty(qtyVal) {
        const qty = parseInt(qtyVal, 10) || 1;
        document.getElementById('catModalHiddenQty').value = qty;
        const subtotal = currentPartPrice * qty;
        const shipping = subtotal >= 200000 ? 0 : 18000;
        const total = subtotal + shipping;
        const totalFormatted = '$' + total.toLocaleString('es-CO') + ' COP' + (shipping === 0 ? ' (Envío Gratis)' : '');
        document.getElementById('catModalDisplayTotal').textContent = totalFormatted;
    }

    function switchCatModalPM(methodKey) {
        const boxes = document.querySelectorAll('.cat-modal-fields');
        boxes.forEach(b => b.classList.add('hidden'));

        const target = document.getElementById('cat-modal-field-' + methodKey);
        if (target) {
            target.classList.remove('hidden');
        }

        const cards = document.querySelectorAll('.cat-modal-pm-card');
        cards.forEach(c => {
            const input = c.querySelector('input[type="radio"]');
            if (input && input.value === methodKey) {
                input.checked = true;
                c.classList.add('border-brand-500', 'bg-brand-50/60');
                c.classList.remove('border-slate-200');
            } else {
                c.classList.remove('border-brand-500', 'bg-brand-50/60');
                c.classList.add('border-slate-200');
            }
        });
    }
</script>

