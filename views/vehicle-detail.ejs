<%- include('header') %>

<!-- Breadcrumb -->
<div class="bg-slate-100 border-b border-slate-200 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs font-semibold text-slate-500 flex items-center gap-2">
        <a href="/" class="hover:text-slate-900">Inicio</a>
        <span>/</span>
        <a href="/vehiculos" class="hover:text-slate-900">Vehículos Certificados</a>
        <span>/</span>
        <span class="text-slate-900 font-bold"><%= vehicle.title %></span>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Vehicle Main Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between pb-6 mb-6 border-b border-slate-200 gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                <span class="bg-emerald-600 text-white text-xs font-black px-2.5 py-1 rounded-lg">
                    ★ Peritaje <%= vehicle.inspection_score %>/10
                </span>
                <span class="bg-slate-900 text-white text-xs font-bold px-2.5 py-1 rounded-lg">
                    <%= vehicle.condition %>
                </span>
                <span class="bg-brand-50 text-brand-700 text-xs font-bold px-2.5 py-1 rounded-lg border border-brand-200">
                    VIN: <%= vehicle.vin %>
                </span>
            </div>
            <h1 class="font-display text-2xl sm:text-4xl font-black text-slate-900"><%= vehicle.title %></h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Año <%= vehicle.year %> • <%= vehicle.mileage_km.toLocaleString('es-CO') %> km • <%= vehicle.fuel %> • <%= vehicle.transmission %> • Ubicado en <%= vehicle.city %>
            </p>
        </div>

        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 flex items-center justify-between lg:justify-end gap-6">
            <div>
                <span class="text-[11px] text-slate-400 block font-semibold">Precio de Contado</span>
                <span class="text-2xl sm:text-3xl font-black text-slate-900"><%= formatUSD(vehicle.price_usd) %></span>
                <span class="text-xs text-slate-500 font-semibold block"><%= formatCOP(vehicle.price_cop) %></span>
            </div>
            <button 
                type="button" 
                onclick="document.getElementById('reservationModal').classList.remove('hidden')" 
                class="px-5 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-black transition shadow-lg shadow-brand-600/30"
            >
                Apartar por $500 USD
            </button>
        </div>
    </div>

    <!-- MAIN GRID: 360 VIEWER & SIDE ACTIONS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
        
        <!-- 360 DEGREE INTERACTIVE VIEWER -->
        <div class="lg:col-span-8 space-y-4">
            <div class="bg-slate-950 rounded-3xl p-4 sm:p-6 text-white shadow-xl relative overflow-hidden border border-slate-800">
                
                <div class="flex items-center justify-between mb-3 text-xs">
                    <span class="flex items-center gap-1.5 font-bold text-emerald-400">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Simulador de Giro 360° Exterior HD
                    </span>
                    <span class="text-slate-400 font-mono" id="angleLabel">Ángulo: 0° (Frontal)</span>
                </div>

                <!-- 360 View Frame -->
                <div class="relative h-80 sm:h-[420px] rounded-2xl overflow-hidden bg-slate-900 flex items-center justify-center select-none cursor-grab" id="viewer360">
                    <img 
                        id="img360" 
                        src="<%= vehicle.gallery_360[0] %>" 
                        alt="<%= vehicle.title %> 360" 
                        class="w-full h-full object-cover transition-opacity duration-150"
                    >

                    <!-- Hint Overlay -->
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-slate-950/80 backdrop-blur-md px-4 py-1.5 rounded-full border border-slate-700 text-[11px] text-slate-300 pointer-events-none flex items-center gap-2">
                        <span>🔄</span> Arrastra horizontalmente o usa los controles para rotar
                    </div>
                </div>

                <!-- Controls Bar -->
                <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-800 flex-wrap gap-2">
                    <div class="flex items-center gap-2">
                        <button 
                            type="button" 
                            onclick="prev360Angle()" 
                            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-200 transition"
                        >
                            ◀ Rotar Izquierda
                        </button>
                        <button 
                            type="button" 
                            onclick="next360Angle()" 
                            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-200 transition"
                        >
                            Rotar Derecha ▶
                        </button>
                    </div>

                    <button 
                        type="button" 
                        id="autoRotateBtn" 
                        onclick="toggleAutoRotate()" 
                        class="px-3.5 py-1.5 rounded-lg bg-brand-600 hover:bg-brand-500 text-xs font-black text-white transition flex items-center gap-1"
                    >
                        <span>▶</span> Auto-Rotar 360°
                    </button>
                </div>
            </div>

            <!-- Standard Image Gallery Thumbnails -->
            <div class="grid grid-cols-4 gap-3">
                <% vehicle.gallery.forEach((imgUrl, idx) => { %>
                    <div 
                        onclick="changeMainImg('<%= imgUrl %>')" 
                        class="h-20 sm:h-24 rounded-2xl overflow-hidden cursor-pointer border-2 border-transparent hover:border-brand-500 transition"
                    >
                        <img src="<%= imgUrl %>" alt="Foto <%= idx + 1 %>" class="w-full h-full object-cover">
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- RIGHT SIDEBAR: QUICK SUMMARY & CTA -->
        <div class="lg:col-span-4 space-y-6">
            
            <!-- Guaranteed Trust Card -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
                <h3 class="font-display font-black text-slate-900 text-base">Garantía & Confianza AutoHub</h3>
                
                <div class="space-y-3 text-xs">
                    <div class="flex items-start gap-3 p-3 rounded-xl bg-emerald-50 text-emerald-900 border border-emerald-100">
                        <span class="text-xl">🛡️</span>
                        <div>
                            <span class="font-black block">1 Año de Garantía Mecánica</span>
                            <span class="text-emerald-700 text-[11px]">Motor, caja de cambios y sistema eléctrico cubiertos al 100%.</span>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 text-slate-800 border border-slate-100">
                        <span class="text-xl">📋</span>
                        <div>
                            <span class="font-black block">Historial Legal Verificado</span>
                            <span class="text-slate-500 text-[11px]">Cero siniestros graves, libre de prendas y listo para traspaso.</span>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 text-slate-800 border border-slate-100">
                        <span class="text-xl">🚚</span>
                        <div>
                            <span class="font-black block">Entrega a Domicilio o Test Drive</span>
                            <span class="text-slate-500 text-[11px]">Llevamos el auto a tu casa para prueba de manejo.</span>
                        </div>
                    </div>
                </div>

                <div class="pt-2 space-y-2">
                    <button 
                        type="button" 
                        onclick="openVehicleReservationModal()" 
                        class="w-full py-3.5 bg-brand-600 hover:bg-brand-700 text-white font-black rounded-xl transition shadow-lg shadow-brand-600/25 text-xs uppercase tracking-wider"
                    >
                        🔒 Reservar Ahora ($500 USD / $2M COP)
                    </button>
                    <button 
                        type="button" 
                        onclick="alert('¡Solicitud de Test Drive enviada! Un asesor te llamará en 15 minutos.');" 
                        class="w-full py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold rounded-xl transition text-xs"
                    >
                        📅 Agendar Test Drive a Domicilio
                    </button>
                </div>
            </div>

            <!-- Fast Contact Expert -->
            <div class="bg-slate-900 text-white rounded-3xl p-6 border border-slate-800 space-y-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-brand-600 flex items-center justify-center font-bold text-base">
                        👨‍🔧
                    </div>
                    <div>
                        <h4 class="font-bold text-xs">Asesor Especialista Asignado</h4>
                        <span class="text-[11px] text-emerald-400">● En línea para responder dudas</span>
                    </div>
                </div>
                <p class="text-xs text-slate-300">¿Quieres conocer detalles del peritaje o negociar tu auto en parte de pago?</p>
                <a 
                    href="https://api.whatsapp.com/send?text=Hola,%20estoy%20interesado%20en%20el%20<%= encodeURIComponent(vehicle.title) %>" 
                    target="_blank" 
                    class="block text-center py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl transition text-xs"
                >
                    💬 Hablar por WhatsApp
                </a>
            </div>

        </div>
    </div>

    <!-- TABS: 150-PT INSPECTION, LEGAL REPORT, SPECS & FINANCING CALCULATOR -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-8">
        
        <!-- Section 1: Peritaje de 150 Puntos -->
        <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2 mb-6">
                <div>
                    <span class="text-emerald-700 font-bold text-xs uppercase tracking-wider">Peritaje Técnico Profesional</span>
                    <h2 class="font-display font-black text-2xl text-slate-900">Inspección Certificada de 150 Puntos</h2>
                </div>
                <div class="bg-emerald-50 border border-emerald-200 px-4 py-2 rounded-2xl flex items-center gap-2">
                    <span class="text-emerald-700 font-extrabold text-lg"><%= vehicle.inspection_score %> / 10</span>
                    <span class="text-xs text-emerald-800 font-semibold">Estado Sobresaliente</span>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 text-center">
                    <span class="text-xs text-slate-500 font-bold block mb-1">Motor & Turbo</span>
                    <span class="text-xl font-black text-emerald-600"><%= vehicle.inspection_details.engine %>%</span>
                    <span class="text-[10px] text-slate-400 block mt-1">Compresión y estanqueidad óptimas</span>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 text-center">
                    <span class="text-xs text-slate-500 font-bold block mb-1">Transmisión</span>
                    <span class="text-xl font-black text-emerald-600"><%= vehicle.inspection_details.transmission %>%</span>
                    <span class="text-[10px] text-slate-400 block mt-1">Cambios fluidos sin tirones</span>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 text-center">
                    <span class="text-xs text-slate-500 font-bold block mb-1">Frenos & Suspensión</span>
                    <span class="text-xl font-black text-emerald-600"><%= vehicle.inspection_details.brakes_suspension %>%</span>
                    <span class="text-[10px] text-slate-400 block mt-1">Discos y amortiguadores al 90%+</span>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 text-center">
                    <span class="text-xs text-slate-500 font-bold block mb-1">Chasis & Pintura</span>
                    <span class="text-xl font-black text-emerald-600"><%= vehicle.inspection_details.chassis_body %>%</span>
                    <span class="text-[10px] text-slate-400 block mt-1">Estructura original sin golpes</span>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 text-center col-span-2 sm:col-span-1">
                    <span class="text-xs text-slate-500 font-bold block mb-1">Electrónica & ADAS</span>
                    <span class="text-xl font-black text-emerald-600"><%= vehicle.inspection_details.electronics_interior %>%</span>
                    <span class="text-[10px] text-slate-400 block mt-1">Escáner OBD-II 100% limpio</span>
                </div>
            </div>
        </div>

        <!-- Section 2: Historial Legal & Documental -->
        <div class="pt-6 border-t border-slate-100">
            <h3 class="font-display font-black text-xl text-slate-900 mb-4">Reporte Legal & Documental</h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                    <span class="text-slate-400 font-bold block mb-1">Historial de Propietarios</span>
                    <span class="text-slate-900 font-black text-sm">
                        <%= vehicle.legal_report.single_owner ? '1 Único Propietario' : `${vehicle.legal_report.owners_count} Propietarios` %>
                    </span>
                    <span class="text-[10px] text-emerald-600 font-semibold block mt-1">✓ Historial certificado</span>
                </div>
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                    <span class="text-slate-400 font-bold block mb-1">Historial de Siniestros</span>
                    <span class="text-slate-900 font-black text-sm">0 Accidentes Reportados</span>
                    <span class="text-[10px] text-emerald-600 font-semibold block mt-1">✓ Sin reclamaciones aseguradora</span>
                </div>
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                    <span class="text-slate-400 font-bold block mb-1">Seguro SOAT & RTM</span>
                    <span class="text-slate-900 font-black text-sm"><%= vehicle.legal_report.soat_status %></span>
                    <span class="text-[10px] text-slate-500 font-semibold block mt-1"><%= vehicle.legal_report.rtm_status %></span>
                </div>
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                    <span class="text-slate-400 font-bold block mb-1">Situación Jurídica</span>
                    <span class="text-slate-900 font-black text-sm">Libre de Gravámenes</span>
                    <span class="text-[10px] text-emerald-600 font-semibold block mt-1">✓ Listo para traspaso en 24h</span>
                </div>
            </div>
        </div>

        <!-- Section 3: Especificaciones Técnicas & Equipamiento -->
        <div class="pt-6 border-t border-slate-100">
            <h3 class="font-display font-black text-xl text-slate-900 mb-4">Especificaciones Técnicas</h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-3 text-xs">
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-slate-500 font-bold">Motorización</span>
                        <span class="font-black text-slate-900"><%= vehicle.engine %></span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-slate-500 font-bold">Potencia Máxima</span>
                        <span class="font-black text-slate-900"><%= vehicle.horsepower %> HP</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-slate-500 font-bold">Torque</span>
                        <span class="font-black text-slate-900"><%= vehicle.torque %></span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-slate-500 font-bold">Aceleración</span>
                        <span class="font-black text-slate-900"><%= vehicle.acceleration %></span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-slate-500 font-bold">Tracción</span>
                        <span class="font-black text-slate-900"><%= vehicle.drivetrain %></span>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs font-black text-slate-400 uppercase tracking-wider mb-3">Equipamiento & Confort Destacado</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <% vehicle.features.forEach(feat => { %>
                            <div class="flex items-center gap-2 p-2 rounded-xl bg-slate-50 text-xs font-semibold text-slate-700">
                                <span class="text-brand-600 font-bold">✓</span>
                                <span><%= feat %></span>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 4: Calculadora de Financiamiento en Vivo -->
        <div class="pt-6 border-t border-slate-100 bg-slate-900 text-white p-6 sm:p-8 rounded-3xl" id="calcCredito">
            <div class="max-w-3xl">
                <span class="text-amber-400 font-extrabold text-xs uppercase tracking-wider">Simulador de Crédito</span>
                <h3 class="font-display font-black text-2xl mt-1">Calcula tu Cuota Mensual Estimada</h3>
                <p class="text-xs text-slate-400 mt-1">Aprobación en 2 horas con bancos aliados sin trámites presenciales.</p>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-300 uppercase mb-2">Cuota Inicial (30%)</label>
                        <input 
                            type="range" 
                            id="downPaymentRange" 
                            min="20" 
                            max="60" 
                            value="30" 
                            step="5" 
                            oninput="updateFinanceCalc(<%= vehicle.price_usd %>, <%= vehicle.price_cop %>)" 
                            class="w-full accent-brand-500"
                        >
                        <span class="text-xs text-brand-300 font-bold block mt-1" id="downPaymentLabel">30% ($<%= (vehicle.price_usd * 0.3).toLocaleString() %> USD)</span>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-300 uppercase mb-2">Plazo en Meses</label>
                        <select 
                            id="loanTerm" 
                            onchange="updateFinanceCalc(<%= vehicle.price_usd %>, <%= vehicle.price_cop %>)" 
                            class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs font-bold text-white focus:outline-none"
                        >
                            <option value="24">24 Meses (2 Años)</option>
                            <option value="36">36 Meses (3 Años)</option>
                            <option value="48" selected>48 Meses (4 Años)</option>
                            <option value="60">60 Meses (5 Años)</option>
                        </select>
                    </div>

                    <div class="bg-slate-800/80 p-4 rounded-2xl border border-slate-700 flex flex-col justify-center">
                        <span class="text-[11px] text-slate-400 font-bold block">Cuota Mensual Estimada</span>
                        <span class="text-2xl font-black text-emerald-400" id="monthlyQuotaUSD">$1,280 USD/mes</span>
                        <span class="text-[11px] text-slate-400 block" id="monthlyQuotaCOP">~$5.050.000 COP/mes</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- RESERVATION & PURCHASE MODAL -->
<div id="reservationModal" class="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-md hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-2xl w-full shadow-2xl border border-slate-200 relative my-8 overflow-hidden max-h-[92vh] flex flex-col">
        
        <!-- Modal Header -->
        <div class="p-5 sm:p-6 bg-gradient-to-r from-slate-900 via-slate-800 to-brand-950 text-white relative shrink-0">
            <button type="button" onclick="document.getElementById('reservationModal').classList.add('hidden')" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-sm transition">✕</button>
            
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-brand-500/20 border border-brand-400/30 text-brand-300 flex items-center justify-center font-bold text-2xl shrink-0">
                    🔒
                </div>
                <div>
                    <span class="bg-brand-500/20 text-brand-300 font-bold text-[10px] uppercase px-2 py-0.5 rounded-md border border-brand-400/20">
                        Apartado Seguro de Inventario
                    </span>
                    <h3 class="font-display font-black text-lg sm:text-xl text-white mt-0.5"><%= vehicle.title %> (<%= vehicle.year %>)</h3>
                    <p class="text-xs text-slate-300">Garantía de retención exclusiva por 72 horas • Depósito: <strong class="text-emerald-400">$500 USD / $2.000.000 COP</strong></p>
                </div>
            </div>
        </div>

        <!-- Modal Body (Scrollable) -->
        <form action="/vehiculos/reservar" method="POST" id="vehiclePurchaseForm" class="p-5 sm:p-6 overflow-y-auto space-y-5 flex-1">
            <input type="hidden" name="vehicle_id" value="<%= vehicle.id %>">
            
            <!-- STEP 1: CUSTOMER CONTACT -->
            <div>
                <h4 class="text-xs font-black text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-2">
                    <span class="w-5 h-5 rounded-full bg-brand-600 text-white text-[10px] flex items-center justify-center font-bold">1</span>
                    Datos del Titular de la Reserva
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Nombre Completo *</label>
                        <input type="text" name="customer_name" required placeholder="Ej: Carlos Andrés Gómez" value="Carlos Gómez" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-brand-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Email de Notificación *</label>
                        <input type="email" name="customer_email" required placeholder="correo@ejemplo.com" value="carlos.gomez@ejemplo.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-brand-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Teléfono / WhatsApp *</label>
                        <input type="tel" name="customer_phone" required placeholder="+57 300 123 4567" value="+57 310 987 6543" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-brand-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Ciudad de Entrega</label>
                        <input type="text" name="customer_city" value="<%= vehicle.city %>" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-brand-500 focus:outline-none">
                    </div>
                </div>
            </div>

            <!-- STEP 2: SELECT PAYMENT METHOD -->
            <div class="pt-2 border-t border-slate-100">
                <h4 class="text-xs font-black text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-2">
                    <span class="w-5 h-5 rounded-full bg-brand-600 text-white text-[10px] flex items-center justify-center font-bold">2</span>
                    Selecciona tu Método de Pago o Banco
                </h4>

                <!-- Payment Method Selector Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 mb-4">
                    
                    <!-- Option PSE -->
                    <label class="payment-method-card border-2 border-brand-500 bg-brand-50/60 rounded-2xl p-3 cursor-pointer transition flex flex-col items-center text-center gap-1.5 hover:border-brand-600">
                        <input type="radio" name="payment_method" value="pse" checked onchange="switchPaymentMethod('pse')" class="sr-only">
