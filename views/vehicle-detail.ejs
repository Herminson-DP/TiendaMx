<!-- Interactive Scripts for Dynamic Payment Methods & Banks -->
<script>
    function switchPaymentMethod(methodKey) {
        // Hide all method field boxes
        const boxes = document.querySelectorAll('.payment-fields-box');
        boxes.forEach(b => b.classList.add('hidden'));

        // Show target box
        const target = document.getElementById('method-' + methodKey);
        if (target) {
            target.classList.remove('hidden');
        }

        // Update active styling on cards
        const cards = document.querySelectorAll('.payment-method-card');
        cards.forEach(c => {
            const input = c.querySelector('input[type="radio"]');
            if (input && input.value === methodKey) {
                input.checked = true;
                c.classList.add('border-brand-500', 'bg-brand-50/60');
                c.classList.remove('border-slate-200');
            } else {
                c.classList.remove('border-brand-500', 'bg-brand-50/60');
                c.classList.add('border-slate-200');
            }
        });
    }

    function updatePseBankInfo(bankName) {
        const titleEl = document.getElementById('pseBankNameTitle');
        const instEl = document.getElementById('pseBankInstruction');
        if (!titleEl || !instEl) return;

        titleEl.textContent = bankName + ':';

        const bankInstructions = {
            'Bancolombia': 'Ten a la mano tu Clave Dinámica o App Móvil Bancolombia para autorizar la transacción de $2.000.000 COP con débito seguro.',
            'Banco de Bogotá': 'Ingresa con tu clave segura del portal web o genera tu Token Digital en la App Móvil de Banco de Bogotá.',
            'Davivienda': 'Ten listo tu número de identificación y tu clave virtual de Davivienda para autorizar en el portal seguro.',
            'BBVA Colombia': 'Valida tu ingreso con Token BBVA o biometría facial desde la aplicación BBVA Móvil.',
            'Banco de Occidente': 'Se solicitará tu clave de Banca Móvil y el código OTP enviado a tu número celular registrado.',
            'Banco Popular': 'Accede con tu usuario y contraseña de Zona Transaccional del Banco Popular.',
            'Banco AV Villas': 'Ingresa con tu contraseña de Banca Virtual y Clave de Audio/Token AV Villas.',
            'Scotiabank Colpatria': 'Verifica la operación mediante el código de seguridad o Token de la App Scotiabank Colpatria.',
            'Banco Caja Social': 'Ingresa con tu usuario amigo y clave de internet de Banco Caja Social.',
            'Banco Itaú Colombia': 'Autoriza con tu clave de internet y el código dinámico Itaú.',
            'Banco Agrario de Colombia': 'Usa tu usuario de Banca Virtual del Banco Agrario de Colombia.',
            'Lulo Bank': 'Recibirás una notificación en tu App de Lulo Bank para aprobar el débito.',
            'Nu Colombia (Nubank)': 'Se generará la orden de débito directo Nu con confirmación en la app de Nu.',
            'Dale!': 'Ingresa con tu celular y clave de Dale! para débito en línea.',
            'Nequi': 'Usa tu número celular Nequi y confirma la notificación push de pago.',
            'Daviplata': 'Ingresa tu número de celular y confirma el código SMS de Daviplata.',
            'RappiPay': 'Autoriza desde tu cuenta RappiPay con tu PIN de 4 dígitos.'
        };

        instEl.textContent = bankInstructions[bankName] || 'Serás dirigido a la plataforma segura de ' + bankName + ' con cifrado bancario ACH de 256 bits.';
    }

    function updateTargetAccountBox(accountString) {
        const numEl = document.getElementById('targetAccNumber');
        if (!numEl) return;
        if (accountString.includes('Bancolombia')) {
            numEl.textContent = '048-928192-11';
        } else if (accountString.includes('Bogotá')) {
            numEl.textContent = '184-930129-84';
        } else if (accountString.includes('Davivienda')) {
            numEl.textContent = '009-482019-22';
        } else if (accountString.includes('BBVA')) {
            numEl.textContent = '018-382910-55';
        }
    }

    function copyAccountNumber() {
        const numEl = document.getElementById('targetAccNumber');
        if (numEl) {
            navigator.clipboard.writeText(numEl.textContent.trim());
            alert('✓ Número de cuenta copiado al portapapeles: ' + numEl.textContent.trim());
        }
    }

    function detectCardBrand(val) {
        const clean = val.replace(/\D/g, '');
        const badge = document.getElementById('cardBrandBadge');
        const icon = document.getElementById('cardIconPreview');
        if (!badge || !icon) return;

        if (clean.startsWith('4')) {
            badge.innerHTML = '<span class="bg-blue-600 text-white px-2 py-0.5 rounded text-[10px] font-black">VISA</span>';
            icon.textContent = '💳';
        } else if (clean.startsWith('5')) {
            badge.innerHTML = '<span class="bg-orange-600 text-white px-2 py-0.5 rounded text-[10px] font-black">MasterCard</span>';
            icon.textContent = '💳';
        } else if (clean.startsWith('34') || clean.startsWith('37')) {
            badge.innerHTML = '<span class="bg-sky-700 text-white px-2 py-0.5 rounded text-[10px] font-black">American Express</span>';
            icon.textContent = '💳';
        } else if (clean.startsWith('6')) {
            badge.innerHTML = '<span class="bg-amber-600 text-white px-2 py-0.5 rounded text-[10px] font-black">Discover / Diners</span>';
            icon.textContent = '💳';
        } else {
            badge.innerHTML = '<span class="bg-slate-200 text-slate-700 px-2 py-0.5 rounded text-[10px] font-bold">Tarjeta Débito/Crédito</span>';
            icon.textContent = '💳';
        }
    }
</script>

<!-- 360 Degree Viewer Script -->
<script>
    const images360 = <%- JSON.stringify(vehicle.gallery_360) %>;
    let current360Index = 0;
    let autoRotateInterval = null;

    function render360() {
        const img = document.getElementById('img360');
        const label = document.getElementById('angleLabel');
        if (img && images360.length > 0) {
            img.src = images360[current360Index];
            const angle = Math.round((current360Index / images360.length) * 360);
            label.textContent = `Ángulo: ${angle}° (${current360Index + 1}/${images360.length})`;
        }
    }

    function next360Angle() {
        current360Index = (current360Index + 1) % images360.length;
        render360();
    }

    function prev360Angle() {
        current360Index = (current360Index - 1 + images360.length) % images360.length;
        render360();
    }

    function toggleAutoRotate() {
        const btn = document.getElementById('autoRotateBtn');
        if (autoRotateInterval) {
            clearInterval(autoRotateInterval);
            autoRotateInterval = null;
            btn.innerHTML = '<span>▶</span> Auto-Rotar 360°';
            btn.className = 'px-3.5 py-1.5 rounded-lg bg-brand-600 hover:bg-brand-500 text-xs font-black text-white transition flex items-center gap-1';
        } else {
            autoRotateInterval = setInterval(next360Angle, 300);
            btn.innerHTML = '<span>⏸</span> Pausar Giro';
            btn.className = 'px-3.5 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-xs font-black text-white transition flex items-center gap-1';
        }
    }

    function changeMainImg(src) {
        const img = document.getElementById('img360');
        if (img) img.src = src;
    }

    function openVehicleReservationModal() {
        if (!window.IS_USER_LOGGED_IN) {
            showAuthRequiredModal(window.location.pathname, 'Para reservar o comprar este vehículo certificado debes registrarte si no estás registrado o iniciar sesión si ya tienes cuenta en AutoHub.');
            return;
        }
        document.getElementById('reservationModal').classList.remove('hidden');
    }

    // Drag-to-rotate interaction on 360 viewer
    let isDragging = false;
    let startX = 0;

    const viewer = document.getElementById('viewer360');
    if (viewer) {
        viewer.addEventListener('mousedown', (e) => {
            isDragging = true;
            startX = e.clientX;
        });

        window.addEventListener('mouseup', () => { isDragging = false; });

        viewer.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            const diff = e.clientX - startX;
            if (Math.abs(diff) > 30) {
                if (diff > 0) prev360Angle();
                else next360Angle();
                startX = e.clientX;
            }
        });
    }

    function updateFinanceCalc(priceUSD, priceCOP) {
        const downPercent = Number(document.getElementById('downPaymentRange').value);
        const term = Number(document.getElementById('loanTerm').value);

        const downUSD = Math.round(priceUSD * (downPercent / 100));
        document.getElementById('downPaymentLabel').textContent = `${downPercent}% ($${downUSD.toLocaleString()} USD)`;

        const loanAmountUSD = priceUSD - downUSD;
        const annualRate = 0.12; // 12% annual
        const monthlyRate = annualRate / 12;
        const monthlyPaymentUSD = Math.round((loanAmountUSD * monthlyRate) / (1 - Math.pow(1 + monthlyRate, -term)));
        const monthlyPaymentCOP = Math.round(monthlyPaymentUSD * 3950);

        document.getElementById('monthlyQuotaUSD').textContent = `$${monthlyPaymentUSD.toLocaleString()} USD/mes`;
        document.getElementById('monthlyQuotaCOP').textContent = `~$${monthlyPaymentCOP.toLocaleString('es-CO')} COP/mes`;
    }

    // Initial calc
    document.addEventListener('DOMContentLoaded', () => {
        updateFinanceCalc(<%= vehicle.price_usd %>, <%= vehicle.price_cop %>);
    });
</script>

