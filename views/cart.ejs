<%- include('header') %>

<div class="flex-between" style="margin-bottom: 24px;">
    <h2>Tu Carrito de Compras (<%= details.items.length %> <%= details.items.length === 1 ? 'artículo' : 'artículos' %>)</h2>
    <a href="/index.php" class="btn btn-secondary btn-sm">Seguir Comprando</a>
</div>

<% if (!details.items || details.items.length === 0) { %>
    <div style="text-align: center; padding: 60px 20px; background: white; border-radius: 16px; border: 1px solid var(--border);">
        <div style="font-size: 3.5rem; margin-bottom: 16px;">🛒</div>
        <h3>Tu carrito actualmente está vacío</h3>
        <p style="color: var(--text-muted); margin: 8px 0 24px;">Explora nuestras ofertas y encuentra los mejores productos al mejor precio.</p>
        <a href="/index.php" class="btn btn-primary">Ir al Catálogo</a>
    </div>
<% } else { %>
    <div class="cart-layout">
        <!-- Left: Cart Items List -->
        <div class="cart-items-box">
            <!-- Free Shipping Progress Tracker -->
            <div class="free-shipping-card">
                <div class="flex-between" style="font-size: 0.9rem; font-weight: 600;">
                    <% if (details.subtotal >= details.freeThreshold || (details.coupon && details.coupon.type === 'free_shipping')) { %>
                        <span style="color: #065f46;">🎉 ¡Genial! Tu pedido califica para <strong>ENVÍO GRATIS A TODA COLOMBIA</strong></span>
                        <span style="color: #065f46;">100%</span>
                    <% } else { %>
                        <span style="color: var(--primary);">🚚 Agrega <strong><%= formatMoney(details.missingForFreeShipping) %> COP</strong> más para obtener <strong>Envío Gratis</strong></span>
                        <span style="color: var(--primary);"><%= details.freeShippingProgress %>%</span>
                    <% } %>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width: <%= details.subtotal >= details.freeThreshold ? 100 : details.freeShippingProgress %>%;"></div>
                </div>
            </div>

            <!-- Items -->
            <% details.items.forEach(item => { %>
                <div class="cart-item-row">
                    <img 
                        src="<%= item.product.image %>" 
                        alt="<%= item.product.name %>" 
                        class="cart-thumb"
                        onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=60'"
                    >
                    <div>
                        <span class="badge-tag" style="background: #e0e7ff; color: #3730a3; font-size: 0.7rem; margin-bottom: 4px; display: inline-block;">
                            <%= item.product.category %>
                        </span>
                        <h4 style="font-size: 1.05rem; margin-bottom: 4px;">
                            <a href="/index.php?action=product&id=<%= item.product.id %>"><%= item.product.name %></a>
                        </h4>
                        <div style="font-size: 0.85rem; color: var(--text-muted);">
                            Precio Unitario: <strong><%= formatMoney(item.unit_price) %></strong>
                        </div>
                    </div>

                    <!-- Quantity Stepper -->
                    <div>
                        <form action="/index.php?action=update-cart" method="POST" class="auto-update-form" style="margin: 0;">
                            <input type="hidden" name="product_id" value="<%= item.product.id %>">
                            <div class="qty-control">
                                <button type="button" class="qty-btn" data-step="-1">-</button>
                                <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.product.stock || 99 %>" class="qty-input-box">
                                <button type="button" class="qty-btn" data-step="1">+</button>
                            </div>
                        </form>
                    </div>

                    <!-- Subtotal per product -->
                    <div style="text-align: right;">
                        <strong style="font-size: 1.15rem; color: var(--secondary);"><%= formatMoney(item.total) %></strong>
                    </div>

                    <!-- Delete button -->
                    <div>
                        <a href="/index.php?action=remove-from-cart&id=<%= item.product.id %>" class="btn-danger-sm" title="Eliminar del carrito" style="padding: 6px 10px;">
                            ✕
                        </a>
                    </div>
                </div>
            <% }); %>

            <!-- Coupon Recommendations & Promos -->
            <div style="margin-top: 24px; padding-top: 20px; border-top: 1px dashed var(--border);">
                <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">Cupones sugeridos disponibles:</span>
                <div class="flex-gap" style="margin-top: 8px; flex-wrap: wrap;">
                    <span class="btn-copy-code" data-code="BIENVENIDO10" style="cursor: pointer; background: #eef2ff; color: #4338ca; border: 1px dashed #6366f1; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700;">
                        BIENVENIDO10 (-10%)
                    </span>
                    <span class="btn-copy-code" data-code="ENVIOGRATIS" style="cursor: pointer; background: #ecfdf5; color: #065f46; border: 1px dashed #10b981; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700;">
                        ENVIOGRATIS
                    </span>
                    <span class="btn-copy-code" data-code="DESCUENTO50K" style="cursor: pointer; background: #fffbeb; color: #92400e; border: 1px dashed #f59e0b; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700;">
                        DESCUENTO50K (-$50.000 COP)
                    </span>
                </div>
            </div>
        </div>

        <!-- Right: Order Summary -->
        <div class="order-summary-card">
            <h3 style="margin-bottom: 20px; font-size: 1.3rem;">Resumen de la Compra</h3>

            <!-- Coupon Input Box -->
            <div class="coupon-box">
                <label style="font-size: 0.85rem; font-weight: 600; color: var(--secondary);">¿Tienes un cupón de descuento?</label>
                <% if (details.coupon) { %>
                    <div class="coupon-pill-active">
                        <span>🏷️ <strong><%= details.coupon.code %></strong> (<%= details.coupon.description %>)</span>
                        <a href="/index.php?action=remove-coupon" style="color: #991b1b; text-decoration: none; font-weight: 700; margin-left: 8px;" title="Quitar cupón">✕</a>
                    </div>
                <% } else { %>
                    <form action="/index.php?action=apply-coupon" method="POST" class="coupon-input-group">
                        <input type="text" name="coupon_code" placeholder="Código ej. BIENVENIDO10" required class="filter-input" style="flex: 1;">
                        <button type="submit" class="btn btn-primary btn-sm">Aplicar</button>
                    </form>
                <% } %>
            </div>

            <!-- Price Breakdown -->
            <div class="summary-row">
                <span>Subtotal</span>
                <span><%= formatMoney(details.subtotal) %></span>
            </div>

            <% if (details.discountAmount > 0) { %>
                <div class="summary-row" style="color: #059669; font-weight: 600;">
                    <span>Descuento aplicado (<%= details.coupon.code %>)</span>
                    <span>-<%= formatMoney(details.discountAmount) %></span>
                </div>
            <% } %>

            <div class="summary-row">
                <span>Impuestos IVA (<%= config.tax || 19 %>%)</span>
                <span><%= formatMoney(details.tax) %></span>
            </div>

            <div class="summary-row">
                <span>Costo de Envío Estimado</span>
                <span><%= details.shipping === 0 ? 'GRATIS' : formatMoney(details.shipping) %></span>
            </div>

            <div class="summary-row summary-total">
                <span>Total Estimado</span>
                <span><%= formatMoney(details.final_total) %> COP</span>
            </div>

            <div style="margin-top: 24px;">
                <a href="/index.php?action=checkout" class="btn btn-primary btn-block btn-lg" style="box-shadow: 0 4px 14px rgba(79, 70, 229, 0.4);">
                    🔒 Continuar al Pago
                </a>
            </div>

            <div style="margin-top: 18px; font-size: 0.8rem; color: var(--text-muted); text-align: center;">
                🔒 Transacción encriptada con tecnología SSL de 256 bits.
            </div>
        </div>
    </div>
<% } %>

<%- include('footer') %>
