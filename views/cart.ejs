                        <!-- 4. TRANSFER FIELDS CONTAINER -->
                        <div id="cart-method-transfer" class="cart-payment-box bg-slate-50 rounded-2xl p-4 sm:p-5 border border-slate-200 space-y-3.5 hidden animate-fadeIn">
