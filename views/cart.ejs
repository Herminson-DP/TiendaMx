<!-- SCRIPT FOR DYNAMIC PAYMENT SWITCHING & REMOVAL IN CART -->
<script>
    function checkCartAuth(e) {
        if (!window.IS_USER_LOGGED_IN) {
            if (e) e.preventDefault();
            showAuthRequiredModal('/carrito', 'Para finalizar y pagar tu pedido de autopartes debes registrarte si no estás registrado o iniciar sesión si ya tienes cuenta en AutoHub.');
            return false;
        }
        return true;
    }

    function removeCartItem(partId) {
        if (confirm('¿Deseas eliminar este repuesto del carrito?')) {
            const form = document.getElementById('removeCartItemForm');
            const input = document.getElementById('removePartIdInput');
            if (form && input) {
                input.value = partId;
                form.submit();
            }
        }
    }

    function switchCartPaymentMethod(methodKey) {
        // Hide all method field boxes
        const boxes = document.querySelectorAll('.cart-payment-box');
        boxes.forEach(b => b.classList.add('hidden'));

        // Show target box
        const target = document.getElementById('cart-method-' + methodKey);
        if (target) {
            target.classList.remove('hidden');
        }

        // Update active styling on cards
        const cards = document.querySelectorAll('.cart-payment-method-card');
        cards.forEach(c => {
            const input = c.querySelector('input[type="radio"]');
            if (input && input.value === methodKey) {
                input.checked = true;
                c.classList.add('border-brand-500', 'bg-brand-50/60');
                c.classList.remove('border-slate-200');
            } else {
                c.classList.remove('border-brand-500', 'bg-brand-50/60');
                c.classList.add('border-slate-200');
            }
        });
    }

    function updateCartPseBankInfo(bankName) {
        const titleEl = document.getElementById('cartPseBankTitle');
        const instEl = document.getElementById('cartPseInstruction');
        if (!titleEl || !instEl) return;

        titleEl.textContent = bankName + ':';
        const bankInstructions = {
            'Bancolombia': 'Ten a la mano tu Clave Dinámica o App Móvil Bancolombia para autorizar el débito seguro en línea.',
            'Banco de Bogotá': 'Ingresa con tu clave segura del portal web o genera tu Token Digital en la App Móvil de Banco de Bogotá.',
            'Davivienda': 'Ten listo tu número de identificación y tu clave virtual de Davivienda para autorizar en el portal seguro.',
            'BBVA Colombia': 'Valida tu ingreso con Token BBVA o biometría facial desde la aplicación BBVA Móvil.',
            'Banco de Occidente': 'Se solicitará tu clave de Banca Móvil y el código OTP enviado a tu número celular registrado.',
            'Banco Popular': 'Accede con tu usuario y contraseña de Zona Transaccional del Banco Popular.',
            'Banco AV Villas': 'Ingresa con tu contraseña de Banca Virtual y Token AV Villas.',
            'Scotiabank Colpatria': 'Verifica la operación mediante el código de seguridad o Token de la App Scotiabank Colpatria.',
            'Banco Caja Social': 'Ingresa con tu usuario amigo y clave de internet de Banco Caja Social.',
            'Banco Itaú Colombia': 'Autoriza con tu clave de internet y el código dinámico Itaú.',
            'Banco Agrario de Colombia': 'Usa tu usuario de Banca Virtual del Banco Agrario de Colombia.',
            'Lulo Bank': 'Recibirás una notificación en tu App de Lulo Bank para aprobar el débito.',
            'Nu Colombia (Nubank)': 'Se generará la orden de débito directo Nu con confirmación en la app de Nu.',
            'Dale!': 'Ingresa con tu celular y clave de Dale! para débito en línea.',
            'Nequi': 'Usa tu número celular Nequi y confirma la notificación push de pago.',
            'Daviplata': 'Ingresa tu número de celular y confirma el código SMS de Daviplata.',
            'RappiPay': 'Autoriza desde tu cuenta RappiPay con tu PIN de 4 dígitos.'
        };
        instEl.textContent = bankInstructions[bankName] || 'Serás dirigido a la plataforma segura de ' + bankName + ' con cifrado bancario ACH de 256 bits.';
    }

    function detectCartCardBrand(val) {
        const clean = val.replace(/\D/g, '');
        const badge = document.getElementById('cartCardBadge');
        if (!badge) return;

        if (clean.startsWith('4')) {
            badge.innerHTML = '<span class="bg-blue-600 text-white px-2 py-0.5 rounded text-[10px] font-black">VISA</span>';
        } else if (clean.startsWith('5')) {
            badge.innerHTML = '<span class="bg-orange-600 text-white px-2 py-0.5 rounded text-[10px] font-black">MasterCard</span>';
        } else if (clean.startsWith('34') || clean.startsWith('37')) {
            badge.innerHTML = '<span class="bg-sky-700 text-white px-2 py-0.5 rounded text-[10px] font-black">Amex</span>';
        } else if (clean.startsWith('6')) {
            badge.innerHTML = '<span class="bg-amber-600 text-white px-2 py-0.5 rounded text-[10px] font-black">Diners / Discover</span>';
        } else {
            badge.innerHTML = '<span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-2 py-0.5 rounded">Visa / MC / Amex</span>';
        }
    }
</script>

