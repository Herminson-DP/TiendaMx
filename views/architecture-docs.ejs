<!-- Docs Switcher Script -->
<script>
    function switchDocTab(tab) {
        const tabs = ['sitemap', 'database', 'apis', 'flows'];
        tabs.forEach(t => {
            const btn = document.getElementById('docTabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
            const content = document.getElementById('docContent' + t.charAt(0).toUpperCase() + t.slice(1));
            if (btn && content) {
                if (t === tab) {
                    btn.className = 'px-4 py-2 rounded-xl text-xs font-black bg-slate-900 text-white transition whitespace-nowrap';
                    content.classList.remove('hidden');
                } else {
                    btn.className = 'px-4 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition whitespace-nowrap';
                    content.classList.add('hidden');
                }
            }
        });
    }
</script>

