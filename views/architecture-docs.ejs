<pre class="text-sky-300">
-- ============================================================================
-- 1. IDENTIDAD Y GARAJE VIRTUAL
-- ============================================================================
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    phone VARCHAR(20),
    role VARCHAR(20) DEFAULT 'customer' CHECK (role IN ('customer', 'dealer', 'admin', 'mechanic')),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE user_garage_vehicles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    vin VARCHAR(17),
    vehicle_year INT NOT NULL,
    make VARCHAR(80) NOT NULL,
    model VARCHAR(80) NOT NULL,
    trim VARCHAR(80),
    engine VARCHAR(100),
    is_primary BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================================
-- 2. VEHÍCULOS CERTIFICADOS EN VENTA
-- ============================================================================
CREATE TYPE transmission_type AS ENUM ('manual', 'automatic', 'cvt', 'dual_clutch');
CREATE TYPE fuel_type AS ENUM ('gasoline', 'diesel', 'electric', 'hybrid', 'plug_in_hybrid');
CREATE TYPE vehicle_condition AS ENUM ('certified_cpo', 'guaranteed_used', 'new');

CREATE TABLE vehicles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    vin VARCHAR(17) UNIQUE NOT NULL,
    plate_number VARCHAR(15),
    slug VARCHAR(255) UNIQUE NOT NULL,
    title VARCHAR(200) NOT NULL,
    make VARCHAR(80) NOT NULL,
    model VARCHAR(80) NOT NULL,
    vehicle_year INT NOT NULL,
    condition vehicle_condition NOT NULL,
    price_usd NUMERIC(12, 2) NOT NULL,
    price_cop NUMERIC(14, 2) NOT NULL,
    mileage_km INT NOT NULL,
    fuel fuel_type NOT NULL,
    transmission VARCHAR(80) NOT NULL,
    drivetrain VARCHAR(40) NOT NULL, -- AWD, FWD, RWD, 4x4
    engine VARCHAR(120) NOT NULL,
    horsepower INT,
    torque VARCHAR(60),
    doors INT DEFAULT 4,
    exterior_color VARCHAR(50),
    interior_color VARCHAR(50),
    city_location VARCHAR(100) NOT NULL,
    status VARCHAR(20) DEFAULT 'available' CHECK (status IN ('available', 'reserved', 'sold', 'draft')),
    
    -- Peritaje & Reportes
    mechanical_score NUMERIC(3, 1), -- Ej: 9.8 / 10
    inspection_breakdown JSONB,     -- Motor: 100%, Transmisión: 99%, etc.
    legal_report JSONB,             -- SOAT, RTM, Siniestros: 0, Propietarios: 1
    gallery_360_urls JSONB,         -- Array de fotos para rotación 360°
    gallery_images JSONB,           -- Fotos HD de exteriores e interiores
    features_list JSONB,            -- Techo corredizo, ADAS, Apple CarPlay
    
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_vehicles_search ON vehicles(make, model, vehicle_year, price_usd, mileage_km, city_location);
CREATE INDEX idx_vehicles_vin ON vehicles(vin);

-- ============================================================================
-- 3. CATÁLOGO DE AUTOPARTES Y MATRIZ DE COMPATIBILIDAD (ACES/PIES Standard)
-- ============================================================================
CREATE TABLE part_categories (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    slug VARCHAR(120) UNIQUE NOT NULL,
    icon_svg VARCHAR(100)
);

CREATE TABLE parts (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    sku VARCHAR(60) UNIQUE NOT NULL,
    oem_number VARCHAR(120),
    name VARCHAR(200) NOT NULL,
    brand VARCHAR(100) NOT NULL, -- Bosch, Brembo, KYB, etc.
    category_id INT REFERENCES part_categories(id),
    price_usd NUMERIC(10, 2) NOT NULL,
    price_cop NUMERIC(12, 2) NOT NULL,
    old_price_cop NUMERIC(12, 2),
    stock_quantity INT DEFAULT 0,
    rating NUMERIC(2, 1) DEFAULT 5.0,
    reviews_count INT DEFAULT 0,
    
    -- Dimensiones y Peso para Cálculo Logístico
    weight_kg NUMERIC(6, 3) NOT NULL,
    dimensions_cm JSONB, -- { length, width, height }
    
    image_url VARCHAR(500),
    description TEXT,
    specifications JSONB,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE part_fitments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    part_id UUID REFERENCES parts(id) ON DELETE CASCADE,
    make VARCHAR(80) NOT NULL,
    model VARCHAR(80) NOT NULL,
    years_range VARCHAR(50) NOT NULL, -- '2019 - 2024'
    engine VARCHAR(100),              -- '2.5L Gasolina / Híbrido'
    notes TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_fitment_lookup ON part_fitments(make, model);
CREATE INDEX idx_parts_sku ON parts(sku, oem_number);

-- ============================================================================
-- 4. TASACIONES (C2B VEHICLE APPRAISALS)
-- ============================================================================
CREATE TABLE vehicle_appraisals (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id),
    plate VARCHAR(15) NOT NULL,
    vin VARCHAR(17),
    make VARCHAR(80) NOT NULL,
    model VARCHAR(80) NOT NULL,
    vehicle_year INT NOT NULL,
    mileage_km INT NOT NULL,
    condition VARCHAR(30) NOT NULL,
    market_low_usd NUMERIC(12, 2),
    market_high_usd NUMERIC(12, 2),
    instant_offer_usd NUMERIC(12, 2),
    contact_phone VARCHAR(30) NOT NULL,
    status VARCHAR(30) DEFAULT 'pending_inspection',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================================
-- 5. ÓRDENES DE AUTOPARTES Y RESERVAS DE VEHÍCULOS
-- ============================================================================
CREATE TABLE orders (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    order_number VARCHAR(40) UNIQUE NOT NULL,
    user_id UUID REFERENCES users(id),
    order_type VARCHAR(20) CHECK (order_type IN ('parts_purchase', 'vehicle_deposit')),
    status VARCHAR(30) DEFAULT 'paid',
    subtotal NUMERIC(12, 2) NOT NULL,
    shipping_fee NUMERIC(12, 2) DEFAULT 0,
    total NUMERIC(12, 2) NOT NULL,
    payment_method VARCHAR(80),
    shipping_address JSONB,
    tracking_number VARCHAR(100),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);
</pre>
            </div>
        </div>
    </div>

