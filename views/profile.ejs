<%- include('header') %>

<main class="flex-1 py-6 sm:py-10 bg-slate-900/5 min-h-[85vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb & Actions -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
                <a href="/" class="hover:text-blue-600 transition flex items-center gap-1">
                    <span>🏠</span> Inicio
                </a>
                <span>/</span>
                <span class="text-slate-900 font-bold">Mi Cuenta & Perfil AutoHub</span>
            </div>

            <div class="flex items-center gap-2">
                <a href="/logout" onclick="try{localStorage.removeItem('autohub_uid');}catch(e){}" class="text-xs font-bold text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 px-3.5 py-1.5 rounded-xl transition flex items-center gap-1.5">
                    <span>🚪</span> Cerrar Sesión
                </a>
            </div>
        </div>

        <!-- Flash Messages -->
        <% if (typeof flash !== 'undefined' && flash) { %>
            <div class="mb-6 p-4 rounded-2xl border text-xs font-bold flex items-center justify-between <%= flash.type === 'error' ? 'bg-red-50 border-red-200 text-red-700' : 'bg-emerald-50 border-emerald-200 text-emerald-700' %> shadow-sm">
                <div class="flex items-center gap-2.5">
                    <span class="text-base"><%= flash.type === 'error' ? '⚠️' : '✅' %></span>
                    <span><%= flash.message %></span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-700 text-sm">✕</button>
            </div>
        <% } %>

        <!-- User Profile Hero Header Card -->
        <div class="bg-gradient-to-br from-[#0B0F19] via-[#111625] to-[#1E293B] rounded-3xl p-6 sm:p-8 text-white border border-slate-800 shadow-2xl mb-8 relative overflow-hidden">
            <!-- Background Decorative Grid -->
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-600/20 via-transparent to-transparent pointer-events-none"></div>

            <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 relative z-10">
                <div class="flex items-center gap-4 sm:gap-6">
                    <div class="relative group">
                        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-3xl sm:text-4xl shadow-xl shadow-blue-600/30 border border-white/20 shrink-0">
                            <%= currentUser.avatar || '👤' %>
                        </div>
                        <span class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-500 border-2 border-[#0B0F19] rounded-full" title="Conectado a la Base de Datos"></span>
                    </div>

                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <h1 class="text-xl sm:text-2xl font-display font-black text-white">
                                <%= currentUser.name %>
                            </h1>
                            <span class="bg-amber-400 text-slate-950 font-black text-[10px] uppercase px-2.5 py-0.5 rounded-full tracking-wider shadow-sm">
                                <%= currentUser.role || 'Cliente Verificado' %>
                            </span>
                            <span class="bg-blue-900/60 text-blue-200 border border-blue-400/30 font-mono text-[10px] px-2 py-0.5 rounded">
                                ID: <%= currentUser.id %>
                            </span>
                        </div>
                        <p class="text-xs text-slate-300 font-mono mt-1 flex items-center gap-2 flex-wrap">
                            <span>📧 <%= currentUser.email %></span>
                            <span>•</span>
                            <span>📱 <%= currentUser.phone || 'Celular no registrado' %></span>
                        </p>
                        <p class="text-xs text-slate-400 mt-1 flex items-center gap-1.5">
                            <span>📍</span> <%= currentUser.city || 'Bogotá D.C.' %><% if (currentUser.department) { %>, <%= currentUser.department %><% } %> • Miembro registrado en Base de Datos
                        </p>
                    </div>
                </div>

                <!-- Quick Stat Metrics -->
                <div class="grid grid-cols-3 gap-2 sm:gap-3 w-full lg:w-auto">
                    <div class="bg-white/5 border border-white/10 rounded-2xl p-3 text-center">
                        <span class="block text-lg sm:text-xl font-black text-white"><%= (orders && orders.length) || 0 %></span>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Órdenes</span>
                    </div>
                    <div class="bg-white/5 border border-white/10 rounded-2xl p-3 text-center">
                        <span class="block text-lg sm:text-xl font-black text-amber-400"><%= (reservations && reservations.length) || 0 %></span>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Reservas</span>
                    </div>
                    <div class="bg-white/5 border border-white/10 rounded-2xl p-3 text-center">
                        <span class="block text-lg sm:text-xl font-black text-emerald-400"><%= (appraisals && appraisals.length) || 0 %></span>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tasaciones</span>
                    </div>
                </div>
            </div>

            <!-- Profile Nav Tabs -->
            <div class="mt-8 pt-4 border-t border-slate-800 flex items-center gap-2 overflow-x-auto pb-1 text-xs font-bold" id="profileTabs">
                <button type="button" onclick="switchProfileTab('info')" id="tab-btn-info" class="tab-btn px-4 py-2 rounded-xl bg-blue-600 text-white shadow-lg shadow-blue-600/30 transition flex items-center gap-1.5 whitespace-nowrap">
                    <span>👤</span> Mis Datos & Envío
                </button>
                <button type="button" onclick="switchProfileTab('garage')" id="tab-btn-garage" class="tab-btn px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition flex items-center gap-1.5 whitespace-nowrap">
                    <span>🚗</span> Mi Garaje Virtual (<%= (currentUser.garageVehicle && currentUser.garageVehicle.make) ? currentUser.garageVehicle.make : 'Activo' %>)
                </button>
                <button type="button" onclick="switchProfileTab('orders')" id="tab-btn-orders" class="tab-btn px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition flex items-center gap-1.5 whitespace-nowrap">
                    <span>📦</span> Mis Pedidos (<%= (orders && orders.length) || 0 %>)
                </button>
                <button type="button" onclick="switchProfileTab('reservations')" id="tab-btn-reservations" class="tab-btn px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition flex items-center gap-1.5 whitespace-nowrap">
                    <span>🏷️</span> Reservas de Autos (<%= (reservations && reservations.length) || 0 %>)
                </button>
                <button type="button" onclick="switchProfileTab('appraisals')" id="tab-btn-appraisals" class="tab-btn px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition flex items-center gap-1.5 whitespace-nowrap">
                    <span>⚡</span> Tasaciones (<%= (appraisals && appraisals.length) || 0 %>)
                </button>
                <button type="button" onclick="switchProfileTab('security')" id="tab-btn-security" class="tab-btn px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition flex items-center gap-1.5 whitespace-nowrap">
                    <span>🛡️</span> Seguridad
                </button>
            </div>
        </div>

        <!-- TAB CONTENT PANELS -->

        <!-- 1. TAB: PERSONAL INFO & SHIPPING -->
        <div id="tab-panel-info" class="tab-panel space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Left: Form -->
                <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
                        <div>
                            <h2 class="font-display font-black text-slate-900 text-lg flex items-center gap-2">
                                <span>👤</span> Información de Contacto & Facturación
                            </h2>
                            <p class="text-xs text-slate-500 mt-0.5">Tus datos se almacenan de forma segura en la base de datos de AutoHub.</p>
                        </div>
                        <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full">
                            Base de Datos Conectada
                        </span>
                    </div>

                    <form action="/api/profile/update" method="POST" class="space-y-4 text-xs">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1.5">Nombre y Apellidos</label>
                                <input type="text" name="name" value="<%= currentUser.name %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
                            </div>

                            <div>
                                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1.5">Correo Electrónico (No modificable)</label>
                                <input type="email" value="<%= currentUser.email %>" readonly class="w-full bg-slate-100 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-mono text-slate-500 cursor-not-allowed">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1.5">Teléfono Celular / WhatsApp</label>
                                <input type="tel" name="phone" value="<%= currentUser.phone || '' %>" placeholder="+57 310 987 6543" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
                            </div>

                            <div>
                                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1.5">Ciudad Principal</label>
                                <input type="text" name="city" value="<%= currentUser.city || 'Bogotá D.C.' %>" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1.5">Departamento</label>
                                <input type="text" name="department" value="<%= currentUser.department || 'Cundinamarca' %>" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
                            </div>

                            <div>
                                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1.5">Elegir Avatar del Perfil</label>
                                <select name="avatar" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
                                    <option value="👤" <%= currentUser.avatar === '👤' ? 'selected' : '' %>>👤 Clásico</option>
                                    <option value="👨‍💼" <%= currentUser.avatar === '👨‍💼' ? 'selected' : '' %>>👨‍💼 Ejecutivo</option>
                                    <option value="👩‍💻" <%= currentUser.avatar === '👩‍💻' ? 'selected' : '' %>>👩‍💻 Digital</option>
                                    <option value="🏎️" <%= currentUser.avatar === '🏎️' ? 'selected' : '' %>>🏎️ Deportivo</option>
                                    <option value="🚗" <%= currentUser.avatar === '🚗' ? 'selected' : '' %>>🚗 Auto</option>
                                    <option value="🔧" <%= currentUser.avatar === '🔧' ? 'selected' : '' %>>🔧 Mecánico Experto</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1.5">Dirección de Despacho Habitual</label>
                            <input type="text" name="address" value="<%= currentUser.address || '' %>" placeholder="Ej: Calle 93B # 13-45 Apto 402, Edificio Parque 93" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition text-xs flex items-center justify-center gap-2 shadow-lg shadow-blue-600/30 cursor-pointer">
                                <span>💾</span> Guardar Cambios en Base de Datos
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Right: Profile Summary & Badges -->
                <div class="space-y-6">
                    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
                        <h3 class="font-display font-black text-slate-900 text-sm flex items-center gap-2 pb-3 border-b border-slate-100">
                            <span>🛡️</span> Estado de la Cuenta
                        </h3>
                        <div class="space-y-3 text-xs">
                            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-2xl border border-slate-100">
                                <span class="font-bold text-slate-700">Verificación RUNT</span>
                                <span class="text-[10px] font-black text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">Aprobada</span>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-2xl border border-slate-100">
                                <span class="font-bold text-slate-700">Moneda Preferida</span>
                                <span class="font-mono font-bold text-slate-900">Peso Colombiano ($ COP)</span>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-2xl border border-slate-100">
                                <span class="font-bold text-slate-700">Garantía por VIN</span>
                                <span class="text-[10px] font-black text-blue-700 bg-blue-100 px-2 py-0.5 rounded">Activa</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-gradient-to-br from-amber-500 to-amber-600 rounded-3xl p-6 text-slate-950 shadow-xl shadow-amber-500/20 space-y-2">
                        <span class="text-xs font-black uppercase tracking-wider bg-black/10 px-2.5 py-1 rounded-full inline-block">Beneficio Exclusivo</span>
                        <h4 class="font-display font-black text-base">Despacho Gratis en Repuestos</h4>
                        <p class="text-xs text-slate-900/80">Por compras superiores a $200.000 COP en todo el catálogo de autopartes compatibles.</p>
                        <div class="pt-2">
                            <a href="/autopartes" class="inline-block px-4 py-2 bg-slate-950 text-white font-bold rounded-xl text-xs hover:bg-slate-900 transition">
                                Explorar Repuestos &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. TAB: VIRTUAL GARAGE -->
        <div id="tab-panel-garage" class="tab-panel hidden space-y-6">
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-100 mb-6">
                    <div>
                        <h2 class="font-display font-black text-slate-900 text-lg flex items-center gap-2">
                            <span>🚗</span> Mi Garaje Virtual Activo
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">El vehículo registrado aquí filtra automáticamente las autopartes y repuestos OEM 100% compatibles.</p>
                    </div>
                    <span class="text-xs font-black text-blue-700 bg-blue-50 border border-blue-200 px-3 py-1.5 rounded-xl flex items-center gap-1.5">
                        <span>⚡</span> Filtro por VIN & Placa Activado
                    </span>
                </div>

                <!-- Current Active Vehicle Display Card -->
                <div class="p-6 bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl text-white border border-slate-700 shadow-xl mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-xl bg-blue-600/30 border border-blue-400/30 flex items-center justify-center text-3xl">
                            🚘
                        </div>
                        <div>
                            <span class="text-[10px] font-black uppercase text-amber-400 tracking-wider">Vehículo Principal Seleccionado</span>
                            <h3 class="text-lg font-display font-black text-white">
                                <%= (currentUser.garageVehicle && currentUser.garageVehicle.make) ? `${currentUser.garageVehicle.make} ${currentUser.garageVehicle.model} (${currentUser.garageVehicle.year})` : 'Toyota RAV4 (2021)' %>
                            </h3>
                            <p class="text-xs text-slate-300 font-mono mt-0.5">
                                Motor: <%= (currentUser.garageVehicle && currentUser.garageVehicle.engine) ? currentUser.garageVehicle.engine : '2.5L Híbrido' %>
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 w-full sm:w-auto">
                        <div class="bg-amber-400 text-slate-950 font-mono font-black text-base px-4 py-2 rounded-xl border-2 border-amber-300 shadow-lg tracking-wider text-center">
                            <%= (currentUser.garageVehicle && currentUser.garageVehicle.plate) ? currentUser.garageVehicle.plate : 'KLU-842' %>
                        </div>
                        <a href="/autopartes?garage_fit_only=1" class="px-4 py-2.5 bg-blue-600 hover:bg-blue-500 rounded-xl text-xs font-bold text-white transition whitespace-nowrap shadow-lg shadow-blue-600/30">
                            Ver Repuestos para este Auto &rarr;
                        </a>
                    </div>
                </div>

                <!-- Form to Change / Update Vehicle in DB -->
                <div class="border-t border-slate-100 pt-6">
                    <h3 class="font-display font-black text-slate-900 text-sm mb-4 flex items-center gap-2">
                        <span>🔄</span> Cambiar o Registrar Nuevo Vehículo en Base de Datos:
                    </h3>

                    <form action="/api/profile/garage" method="POST" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-xs">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Marca (ej. Toyota, Mazda, BMW)</label>
                            <input type="text" name="garage_make" placeholder="Toyota" value="<%= currentUser.garageVehicle ? currentUser.garageVehicle.make : '' %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Modelo (ej. Corolla, CX-30, Serie 3)</label>
                            <input type="text" name="garage_model" placeholder="Corolla" value="<%= currentUser.garageVehicle ? currentUser.garageVehicle.model : '' %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Año de Fabricación</label>
                            <input type="number" name="garage_year" placeholder="2022" value="<%= currentUser.garageVehicle ? currentUser.garageVehicle.year : '2022' %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Placa (ej. ABC-123)</label>
                            <input type="text" name="garage_plate" placeholder="ABC-123" value="<%= currentUser.garageVehicle ? currentUser.garageVehicle.plate : '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-mono font-bold uppercase focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div class="sm:col-span-2 md:col-span-4 pt-2">
                            <button type="submit" class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl transition text-xs flex items-center justify-center gap-2 cursor-pointer shadow-sm">
                                <span>💾</span> Guardar y Actualizar Garaje Virtual
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- 3. TAB: ORDERS HISTORY (From Database) -->
        <div id="tab-panel-orders" class="tab-panel hidden space-y-6">
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
                    <div>
                        <h2 class="font-display font-black text-slate-900 text-lg flex items-center gap-2">
                            <span>📦</span> Historial de Pedidos de Autopartes
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Órdenes sincronizadas en tiempo real con la base de datos.</p>
                    </div>
                    <a href="/autopartes" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition">
                        + Nueva Compra
                    </a>
                </div>

                <% if (!orders || orders.length === 0) { %>
                    <div class="text-center py-12 bg-slate-50 rounded-2xl border border-slate-200">
                        <span class="text-4xl block mb-3">📦</span>
                        <h3 class="font-display font-bold text-slate-800 text-base">Aún no tienes pedidos registrados</h3>
                        <p class="text-xs text-slate-500 mt-1 mb-4">Cuando realices compras de autopartes, verás el estado de despacho y guía de envío aquí.</p>
                        <a href="/autopartes" class="px-4 py-2 bg-blue-600 text-white font-bold rounded-xl text-xs hover:bg-blue-700 transition">
                            Explorar Catálogo de Repuestos
                        </a>
                    </div>
                <% } else { %>
                    <div class="space-y-4">
                        <% orders.forEach(order => { %>
                            <div class="border border-slate-200 rounded-2xl p-5 hover:border-slate-300 transition bg-slate-50/50 space-y-4">
                                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-slate-200/80">
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono font-black text-slate-900 text-sm">#<%= order.id %></span>
                                            <span class="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full <%= order.status.includes('Entregado') ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800' %>">
                                                ● <%= order.status %>
                                            </span>
                                        </div>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Fecha: <%= order.date %> • Guía: <strong class="font-mono text-blue-600"><%= order.trackingNumber || 'AUTOHUB-COL-8829' %></strong></p>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-[10px] text-slate-500 block uppercase font-bold">Total Pagado:</span>
                                        <span class="font-display font-black text-slate-900 text-base"><%= formatCOP(order.total) %></span>
                                    </div>
                                </div>

                                <!-- Order Items List -->
                                <div class="space-y-2">
                                    <span class="text-[10px] font-bold uppercase text-slate-400">Productos (<%= order.items.length %>):</span>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                        <% order.items.forEach(item => { %>
                                            <div class="bg-white p-3 rounded-xl border border-slate-200 flex items-center justify-between text-xs">
                                                <div>
                                                    <span class="font-bold text-slate-800 block"><%= (item.part && item.part.name) || (item.product && item.product.name) || 'Autoparte OEM' %></span>
                                                    <span class="text-[10px] text-slate-400 font-mono">Cant: <%= item.quantity %> • SKU: <%= (item.part && item.part.sku) || 'OEM-REF' %></span>
                                                </div>
                                                <span class="font-mono font-bold text-slate-900"><%= formatCOP(item.totalCOP || item.total) %></span>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between pt-2 text-xs text-slate-600">
                                    <span>Método: <strong><%= order.paymentMethod %></strong></span>
                                    <span class="text-slate-500">Destino: <%= order.customer ? order.customer.address : 'Bogotá' %></span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- 4. TAB: VEHICLE RESERVATIONS (From Database) -->
        <div id="tab-panel-reservations" class="tab-panel hidden space-y-6">
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
                    <div>
                        <h2 class="font-display font-black text-slate-900 text-lg flex items-center gap-2">
                            <span>🏷️</span> Reservas de Vehículos Certificados
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Apartados con anticipo de $2.000.000 COP y peritaje RUNT garantizado.</p>
                    </div>
                    <a href="/vehiculos" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition">
                        + Ver Autos en Venta
                    </a>
                </div>

                <% if (!reservations || reservations.length === 0) { %>
                    <div class="text-center py-12 bg-slate-50 rounded-2xl border border-slate-200">
                        <span class="text-4xl block mb-3">🚗</span>
                        <h3 class="font-display font-bold text-slate-800 text-base">No tienes vehículos apartados actualmente</h3>
                        <p class="text-xs text-slate-500 mt-1 mb-4">Puedes apartar cualquier auto certificado por 72 horas para asegurar el precio e inspección presencial.</p>
                        <a href="/vehiculos" class="px-4 py-2 bg-blue-600 text-white font-bold rounded-xl text-xs hover:bg-blue-700 transition">
                            Explorar Catálogo de Vehículos
                        </a>
                    </div>
                <% } else { %>
                    <div class="space-y-4">
                        <% reservations.forEach(res => { %>
                            <div class="border border-slate-200 rounded-2xl p-5 hover:border-slate-300 transition bg-slate-50/50 space-y-4">
                                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-slate-200/80">
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono font-black text-slate-900 text-sm">Reserva #<%= res.id %></span>
                                            <span class="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800">
                                                ● <%= res.status %>
                                            </span>
                                        </div>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Fecha: <%= res.date %> • Anticipo: <strong class="text-slate-900"><%= formatCOP(res.deposit_amount_cop) %></strong></p>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-[10px] text-slate-500 block uppercase font-bold">Precio Total Auto:</span>
                                        <span class="font-display font-black text-slate-900 text-base"><%= res.vehicle ? formatCOP(res.vehicle.price_cop) : '$ 0 COP' %></span>
                                    </div>
                                </div>

                                <div class="bg-white p-4 rounded-xl border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                    <div>
                                        <h4 class="font-display font-black text-slate-900 text-sm">
                                            <%= res.vehicle ? res.vehicle.title : 'Vehículo Certificado' %> (<%= res.vehicle ? res.vehicle.year : '2023' %>)
                                        </h4>
                                        <p class="text-xs text-slate-500 font-mono mt-0.5">
                                            Placa: <%= res.vehicle ? res.vehicle.plate : 'KLU-842' %> • VIN: <%= res.vehicle ? res.vehicle.vin : 'PENDIENTE' %>
                                        </p>
                                    </div>
                                    <% if (res.vehicle && res.vehicle.id) { %>
                                        <a href="/vehiculos/<%= res.vehicle.id %>" class="px-3.5 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition">
                                            Ver Ficha Técnica &rarr;
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- 5. TAB: APPRAISALS / TASACIONES (From Database) -->
        <div id="tab-panel-appraisals" class="tab-panel hidden space-y-6">
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
                    <div>
                        <h2 class="font-display font-black text-slate-900 text-lg flex items-center gap-2">
                            <span>⚡</span> Mis Tasaciones Guardadas
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Cotizaciones y ofertas de compra inmediata en Pesos Colombianos ($ COP).</p>
                    </div>
                    <a href="/tasador" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition">
                        + Nueva Tasación
                    </a>
                </div>

                <% if (!appraisals || appraisals.length === 0) { %>
                    <div class="text-center py-12 bg-slate-50 rounded-2xl border border-slate-200">
                        <span class="text-4xl block mb-3">⚡</span>
                        <h3 class="font-display font-bold text-slate-800 text-base">No has tasado vehículos todavía</h3>
                        <p class="text-xs text-slate-500 mt-1 mb-4">Usa nuestro algoritmo de tasación instantánea en 2 minutos para conocer el valor comercial de tu auto.</p>
                        <a href="/tasador" class="px-4 py-2 bg-blue-600 text-white font-bold rounded-xl text-xs hover:bg-blue-700 transition">
                            Tasar mi Auto Ahora
                        </a>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% appraisals.forEach(app => { %>
                            <div class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-blue-400 transition shadow-sm space-y-3">
                                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                                    <span class="font-display font-black text-slate-900 text-sm">
                                        <%= app.make %> <%= app.model %> (<%= app.year %>)
                                    </span>
                                    <span class="font-mono text-xs font-bold bg-amber-100 text-amber-900 px-2 py-0.5 rounded">
                                        <%= app.plate || 'NO-REG' %>
                                    </span>
                                </div>
                                <div class="space-y-1.5 text-xs text-slate-600">
                                    <p>Kilometraje: <strong><%= app.mileage ? app.mileage.toLocaleString('es-CO') : '0' %> km</strong> • Estado: <strong class="capitalize"><%= app.condition || 'Bueno' %></strong></p>
                                    <p>Rango Mercado: <strong class="text-slate-900"><%= formatCOP(app.lowCOP) %> - <%= formatCOP(app.highCOP) %></strong></p>
                                    <div class="p-2.5 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-900 font-bold flex items-center justify-between mt-2">
                                        <span>Oferta Inmediata AutoHub:</span>
                                        <span class="text-sm font-black"><%= formatCOP(app.instantOfferCOP) %></span>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- 6. TAB: SECURITY & PASSWORD -->
        <div id="tab-panel-security" class="tab-panel hidden space-y-6">
            <div class="max-w-2xl bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
                <div class="pb-4 border-b border-slate-100 mb-6">
                    <h2 class="font-display font-black text-slate-900 text-lg flex items-center gap-2">
                        <span>🛡️</span> Seguridad de la Cuenta & Cambio de Contraseña
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Actualiza tu clave de acceso. Se guardará de inmediato en la base de datos.</p>
                </div>

                <form action="/api/profile/change-password" method="POST" class="space-y-4 text-xs">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1.5">Contraseña Actual</label>
                        <input type="password" name="currentPassword" required placeholder="••••••••" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1.5">Nueva Contraseña (Mínimo 6 caracteres)</label>
                        <input type="password" name="newPassword" required minlength="6" placeholder="Nueva contraseña segura" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>

                    <div class="pt-2">
                        <button type="submit" class="px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl transition text-xs flex items-center justify-center gap-2 cursor-pointer shadow-sm">
                            <span>🔐</span> Actualizar Contraseña en Base de Datos
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</main>

<script>
function switchProfileTab(tabName) {
    // Hide all panels
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
    // Unhighlight all buttons
    document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white', 'shadow-lg', 'shadow-blue-600/30');
        b.classList.add('text-slate-300');
    });

    // Show target panel
    const panel = document.getElementById('tab-panel-' + tabName);
    if (panel) panel.classList.remove('hidden');

    // Highlight target button
    const btn = document.getElementById('tab-btn-' + tabName);
    if (btn) {
        btn.classList.add('bg-blue-600', 'text-white', 'shadow-lg', 'shadow-blue-600/30');
        btn.classList.remove('text-slate-300');
    }
}
</script>

<%- include('footer') %>
