<%- include('header') %>

<main class="flex-1 py-6 sm:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb -->
        <div class="flex items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
                <a href="/" class="hover:text-brand-600 transition flex items-center gap-1">
                    <span>🏠</span> Inicio
                </a>
                <span>/</span>
                <span class="text-slate-900 font-bold">Mi Cuenta AutoHub</span>
            </div>

            <div class="flex items-center gap-2">
                <a href="/logout" class="text-xs font-bold text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 px-3.5 py-1.5 rounded-xl transition flex items-center gap-1.5">
                    <span>🚪</span> Cerrar Sesión
                </a>
            </div>
        </div>

        <!-- Flash Messages -->
        <% if (typeof flash !== 'undefined' && flash) { %>
            <div class="mb-6 p-4 rounded-2xl border text-xs font-bold flex items-center justify-between <%= flash.type === 'error' ? 'bg-red-50 border-red-200 text-red-700' : 'bg-emerald-50 border-emerald-200 text-emerald-700' %>">
                <div class="flex items-center gap-2">
                    <span class="text-base"><%= flash.type === 'error' ? '⚠️' : '✅' %></span>
                    <span><%= flash.message %></span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-700 text-sm">✕</button>
            </div>
        <% } %>

        <!-- User Profile Hero Card -->
        <div class="bg-gradient-to-br from-[#0B0F19] via-[#111625] to-[#1E293B] rounded-3xl p-6 sm:p-8 text-white border border-slate-800 shadow-2xl mb-8 relative overflow-hidden">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 relative z-10">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-blue-600 to-amber-500 flex items-center justify-center text-3xl sm:text-4xl shadow-xl shadow-blue-600/30 border border-white/20 shrink-0">
                        <%= currentUser.avatar || '👤' %>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-xl sm:text-2xl font-display font-black text-white">
                                <%= currentUser.name %>
                            </h1>
                            <span class="bg-amber-500 text-slate-950 font-black text-[10px] uppercase px-2 py-0.5 rounded tracking-wider">
                                <%= currentUser.role || 'Cliente Verificado' %>
                            </span>
                        </div>
                        <p class="text-xs text-slate-300 font-mono mt-0.5"><%= currentUser.email %> • <%= currentUser.phone || 'Celular no registrado' %></p>
                        <p class="text-xs text-slate-400 mt-1 flex items-center gap-1.5">
                            <span>📍</span> <%= currentUser.city || 'Bogotá D.C.' %> • Miembro activo de AutoHub Colombia
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <a href="/ordenes" class="flex-1 sm:flex-none text-center px-4 py-2.5 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl text-xs font-bold text-white transition">
                        <span>📦</span> Mis Órdenes (<%= ordersCount || 0 %>)
                    </a>
                    <a href="/autopartes" class="flex-1 sm:flex-none text-center px-4 py-2.5 bg-brand-600 hover:bg-brand-700 rounded-xl text-xs font-bold text-white transition shadow-lg shadow-brand-600/30">
                        <span>🛒</span> Comprar Repuestos
                    </a>
                </div>
            </div>
        </div>

        <!-- 3-Column Profile Dashboard -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- 1. Personal Information & Editor -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="font-display font-black text-slate-900 text-sm flex items-center gap-2">
                        <span>👤</span> Datos Personales
                    </h3>
                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">Cuenta Activa</span>
                </div>

                <form action="/api/profile/update" method="POST" class="space-y-3 text-xs">
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Nombre Completo</label>
                        <input type="text" name="name" value="<%= currentUser.name %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Correo Electrónico (Principal)</label>
                        <input type="email" value="<%= currentUser.email %>" readonly class="w-full bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-xs font-mono text-slate-500 cursor-not-allowed">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Celular / WhatsApp</label>
                        <input type="tel" name="phone" value="<%= currentUser.phone || '' %>" placeholder="+57 310 987 6543" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Ciudad</label>
                        <input type="text" name="city" value="<%= currentUser.city || 'Bogotá D.C.' %>" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Dirección de Envío Habitual</label>
                        <input type="text" name="address" value="<%= currentUser.address || '' %>" placeholder="Calle 93B # 13-45 Apto 402" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </div>

                    <button type="submit" class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl transition text-xs flex items-center justify-center gap-1.5 cursor-pointer">
                        <span>💾</span> Guardar Cambios de Perfil
                    </button>
                </form>
            </div>

            <!-- 2. Virtual Garage -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="font-display font-black text-slate-900 text-sm flex items-center gap-2">
                        <span>🚗</span> Mi Garaje Virtual
                    </h3>
                    <span class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded">Filtro OEM Activo</span>
                </div>

                <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="font-black text-slate-900 text-sm">
                            <%= (currentUser.garageVehicle && currentUser.garageVehicle.make) ? `${currentUser.garageVehicle.make} ${currentUser.garageVehicle.model} (${currentUser.garageVehicle.year})` : 'Toyota RAV4 (2021)' %>
                        </span>
                        <span class="font-mono font-black text-xs bg-amber-100 text-amber-900 px-2 py-0.5 rounded border border-amber-300">
                            <%= (currentUser.garageVehicle && currentUser.garageVehicle.plate) ? currentUser.garageVehicle.plate : 'KLU-842' %>
                        </span>
                    </div>
                    <p class="text-xs text-slate-500">
                        Motor: <%= (currentUser.garageVehicle && currentUser.garageVehicle.engine) ? currentUser.garageVehicle.engine : '2.5L Híbrido' %>
                    </p>
                </div>

                <form action="/api/profile/garage" method="POST" class="space-y-3 text-xs pt-1">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase">Cambiar o Vincular Vehículo:</span>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <input type="text" name="garage_make" placeholder="Marca (ej. Toyota)" value="<%= currentUser.garageVehicle ? currentUser.garageVehicle.make : '' %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:outline-none">
                        </div>
                        <div>
                            <input type="text" name="garage_model" placeholder="Modelo (ej. Corolla)" value="<%= currentUser.garageVehicle ? currentUser.garageVehicle.model : '' %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:outline-none">
                        </div>
                        <div>
                            <input type="number" name="garage_year" placeholder="Año (ej. 2022)" value="<%= currentUser.garageVehicle ? currentUser.garageVehicle.year : '2022' %>" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:outline-none">
                        </div>
                        <div>
                            <input type="text" name="garage_plate" placeholder="Placa (ej. ABC-123)" value="<%= currentUser.garageVehicle ? currentUser.garageVehicle.plate : '' %>" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-mono font-bold uppercase focus:outline-none">
                        </div>
                    </div>

                    <button type="submit" class="w-full py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl transition text-xs flex items-center justify-center gap-1.5 cursor-pointer">
                        <span>🔄</span> Actualizar Garaje
                    </button>
                </form>
            </div>

            <!-- 3. Security & Quick Platform Links -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="font-display font-black text-slate-900 text-sm flex items-center gap-2">
                        <span>🛡️</span> Seguridad & Accesos
                    </h3>
                    <span class="text-[10px] font-bold text-slate-500">2FA Disponible</span>
                </div>

                <div class="space-y-2.5 text-xs">
                    <a href="/ordenes" class="p-3 bg-slate-50 hover:bg-slate-100 rounded-2xl border border-slate-200 flex items-center justify-between transition group">
                        <div class="flex items-center gap-2.5">
                            <span class="text-base">📦</span>
                            <div>
                                <strong class="block text-slate-900 font-bold group-hover:text-brand-600">Historial de Compras</strong>
                                <span class="text-[10px] text-slate-500">Ver recibos y guías de envío</span>
                            </div>
                        </div>
                        <span class="text-slate-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </a>

                    <a href="/tasador" class="p-3 bg-slate-50 hover:bg-slate-100 rounded-2xl border border-slate-200 flex items-center justify-between transition group">
                        <div class="flex items-center gap-2.5">
                            <span class="text-base">⚡</span>
                            <div>
                                <strong class="block text-slate-900 font-bold group-hover:text-brand-600">Tasar un Vehículo</strong>
                                <span class="text-[10px] text-slate-500">Cotización instantánea en COP</span>
                            </div>
                        </div>
                        <span class="text-slate-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </a>

                    <a href="/vehiculos" class="p-3 bg-slate-50 hover:bg-slate-100 rounded-2xl border border-slate-200 flex items-center justify-between transition group">
                        <div class="flex items-center gap-2.5">
                            <span class="text-base">🚗</span>
                            <div>
                                <strong class="block text-slate-900 font-bold group-hover:text-brand-600">Comprar Vehículo Certificado</strong>
                                <span class="text-[10px] text-slate-500">Financiamiento y peritaje RUNT</span>
                            </div>
                        </div>
                        <span class="text-slate-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </a>
                </div>

                <!-- Change Password Form -->
                <div class="pt-2 border-t border-slate-100">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase mb-2">Cambiar Contraseña:</span>
                    <form action="/api/profile/change-password" method="POST" class="space-y-2 text-xs">
                        <input type="password" name="currentPassword" required placeholder="Contraseña actual" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs focus:outline-none">
                        <input type="password" name="newPassword" required minlength="6" placeholder="Nueva contraseña (mín 6 car.)" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs focus:outline-none">
                        <button type="submit" class="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold rounded-xl transition text-[11px] cursor-pointer">
                            Actualizar Contraseña
                        </button>
                    </form>
                </div>
            </div>

        </div>

    </div>
</main>

<%- include('footer') %>
