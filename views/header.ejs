<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : (config ? config.store_name : 'Tienda Colombia') %></title>
    <meta name="description" content="Tienda online colombiana con catálogo de productos en pesos colombianos (COP), carrito, envíos a toda Colombia, pagos PSE, Nequi y Daviplata.">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Top Announcement Bar -->
    <aside class="announcement-bar" aria-label="Anuncios de la tienda">
        <div class="container">
            🇨🇴 <strong>ENVÍO GRATIS A TODA COLOMBIA</strong> en compras superiores a <%= formatMoney(config.free_shipping_threshold || 200000) %> COP &nbsp;|&nbsp; 🏷️ Usa el cupón <strong>BIENVENIDO10</strong> para 10% de descuento
        </div>
    </aside>

    <!-- Main Navigation Bar -->
    <header class="navbar">
        <div class="container nav-inner">
            <!-- Brand Logo -->
            <a href="/index.php" class="brand" id="brandLogo">
                <div class="brand-icon">🛍️</div>
                <span class="brand-text"><%= config.store_name || 'Tienda Colombia' %></span>
            </a>

            <!-- Search Bar -->
            <form action="/index.php" method="GET" class="nav-search-form" id="searchForm">
                <input 
                    type="text" 
                    name="search" 
                    class="nav-search-input" 
                    id="searchInput"
                    placeholder="Buscar tecnología, audio, moda, hogar..." 
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    autocomplete="off"
                >
                <button type="submit" class="nav-search-btn" id="searchBtn" title="Buscar productos">
                    🔍
                </button>
            </form>

            <!-- Navigation Actions -->
            <nav class="nav-actions">
                <a href="/index.php?action=wishlist" class="nav-badge-link" id="navWishlist" title="Mis Favoritos">
                    <span>❤️</span>
                    <span>Favoritos</span>
                    <span class="badge-count badge-wishlist"><%= wishlistCount || 0 %></span>
                </a>

                <a href="/index.php?action=cart" class="nav-badge-link" id="navCart" title="Ver Carrito de Compras">
                    <span>🛒</span>
                    <span>Carrito</span>
                    <span class="badge-count"><%= cartCount || 0 %></span>
                </a>

                <a href="/index.php?action=orders" class="nav-link" id="navOrders" title="Historial de Pedidos">
                    <span>📦</span>
                    <span>Mis Pedidos</span>
                </a>

                <a href="/index.php?action=admin" class="btn-nav-admin" id="navAdmin" title="Panel de Administración">
                    <span>⚙️</span>
                    <span>Admin</span>
                </a>
            </nav>
        </div>
    </header>

    <!-- Main Content Body -->
    <main class="main-content" id="mainContainer">
        <div class="container">
            <!-- Flash Notification Messages -->
            <% if (flash) { %>
                <div class="flash-container" id="flashContainer">
                    <div class="flash-message flash-<%= flash.type || 'info' %>" role="alert">
                        <span><%= flash.message %></span>
                        <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; cursor: pointer; font-size: 1.1rem; color: inherit; line-height: 1;">✕</button>
                    </div>
                </div>
            <% } %>
