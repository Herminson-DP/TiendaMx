    <script>
        // Global Auth State
        window.IS_USER_LOGGED_IN = <%= (typeof currentUser !== 'undefined' && currentUser) ? 'true' : 'false' %>;

        function showAuthRequiredModal(redirectUrl, customMessage) {
            const currentPath = redirectUrl || (window.location.pathname + window.location.search);
            const modal = document.getElementById('authRequiredModal');
            const loginBtn = document.getElementById('authModalLoginBtn');
            const registerBtn = document.getElementById('authModalRegisterBtn');
            const returnInput = document.getElementById('authModalReturnUrlInput');
            const returnDemo1 = document.getElementById('authModalDemoReturn1');
            const returnDemo2 = document.getElementById('authModalDemoReturn2');
            const msgEl = document.getElementById('authRequiredModalMsg');

            if (loginBtn) loginBtn.href = `/login?redirect=${encodeURIComponent(currentPath)}`;
            if (registerBtn) registerBtn.href = `/registro?redirect=${encodeURIComponent(currentPath)}`;
            if (returnInput) returnInput.value = currentPath;
            if (returnDemo1) returnDemo1.value = currentPath;
            if (returnDemo2) returnDemo2.value = currentPath;

            if (customMessage && msgEl) {
                msgEl.textContent = customMessage;
            } else if (msgEl) {
                msgEl.textContent = 'Para continuar con tu compra debes registrarte si no estás registrado o iniciar sesión si ya tienes cuenta en AutoHub Colombia.';
            }

            if (modal) modal.classList.remove('hidden');
        }

        function closeAuthRequiredModal() {
            const modal = document.getElementById('authRequiredModal');
            if (modal) modal.classList.add('hidden');
        }

        function requireAuthOrExecute(callback, redirectUrl, customMessage) {
            if (window.IS_USER_LOGGED_IN) {
                if (typeof callback === 'function') callback();
                return true;
            }
            showAuthRequiredModal(redirectUrl, customMessage);
            return false;
        }

        function openSettingsModal(defaultTab) {
            const modal = document.getElementById('settingsModal');
            if (modal) modal.classList.remove('hidden');
            if (defaultTab && defaultTab !== 'all') {
                switchSettingsTab(defaultTab);
            }
        }

        // Backward compatibility for existing openGarageModal() callers
        function openGarageModal() {
            openSettingsModal('garage');
        }

        function closeSettingsModal() {
            const modal = document.getElementById('settingsModal');
            if (modal) modal.classList.add('hidden');
        }

        function closeGarageModal() {
            closeSettingsModal();
        }

        function switchSettingsTab(tab) {
            const tabs = ['garage', 'regional', 'services'];
            tabs.forEach(t => {
                const tabEl = document.getElementById(`settingsTab${t.charAt(0).toUpperCase() + t.slice(1)}`);
                const btnEl = document.getElementById(`tabBtn${t.charAt(0).toUpperCase() + t.slice(1)}`);
                if (tabEl) {
                    if (t === tab) {
                        tabEl.classList.remove('hidden');
                    } else {
                        tabEl.classList.add('hidden');
                    }
                }
                if (btnEl) {
                    if (t === tab) {
                        btnEl.className = 'px-4 py-2.5 text-xs font-black rounded-t-xl transition border-b-2 border-brand-600 bg-white text-brand-700 shadow-sm flex items-center gap-2 whitespace-nowrap';
                    } else {
                        btnEl.className = 'px-4 py-2.5 text-xs font-bold rounded-t-xl transition border-b-2 border-transparent text-slate-600 hover:text-slate-900 flex items-center gap-2 whitespace-nowrap';
                    }
                }
            });
        }

        function openSearchModal() {
            const modal = document.getElementById('searchModal');
            if (modal) {
                modal.classList.remove('hidden');
                setTimeout(() => {
                    const input = document.getElementById('modalSearchInput');
                    if (input) input.focus();
                }, 100);
            }
        }

        function closeSearchModal() {
            const modal = document.getElementById('searchModal');
            if (modal) modal.classList.add('hidden');
        }

        // GLOBAL KEYBOARD SHORTCUTS (CMD+K / CTRL+K / ESCAPE)
        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                openSearchModal();
            }
            if (e.key === 'Escape') {
                closeSearchModal();
                closeSettingsModal();
                closeAuthRequiredModal();
            }
        });

        // Close modal when clicking backdrop
        document.addEventListener('click', (e) => {
            const searchModal = document.getElementById('searchModal');
            if (searchModal && e.target === searchModal) {
                closeSearchModal();
            }
            const settingsModal = document.getElementById('settingsModal');
            if (settingsModal && e.target === settingsModal) {
                closeSettingsModal();
            }
            const authModal = document.getElementById('authRequiredModal');
            if (authModal && e.target === authModal) {
                closeAuthRequiredModal();
            }
        });
    </script>

    <!-- MAIN APP CONTAINER -->
    <main class="flex-grow">
