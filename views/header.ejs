<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'AutoHub Motors & Parts | Vehículos Certificados y Repuestos' %></title>
    <meta name="description" content="Plataforma líder en e-commerce automotriz: Compraventa de vehículos certificados con peritaje e historial legal, venta de autopartes compatibles por VIN y tasador interactivo.">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['"Space Grotesk"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#0f172a',
                        },
                        accent: {
                            400: '#fb923c',
                            500: '#f97316',
                            600: '#ea580c',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased selection:bg-brand-600 selection:text-white flex flex-col min-h-screen pb-24">

    <!-- CLEAN HIGH-END TOP HEADER (ONLY BRAND NAME & LOGO) -->
    <header class="sticky top-0 z-30 bg-[#0B0F19]/95 backdrop-blur-xl border-b border-slate-800/90 shadow-xl transition-all duration-300" id="mainHeader">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20">
                
                <!-- BRAND LOGO & TITLE ONLY -->
                <a href="/" class="flex items-center gap-3.5 group mx-auto sm:mx-0" id="brandLogo">
                    <div class="relative">
                        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-br from-blue-600 via-indigo-600 to-amber-500 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-blue-600/30 border border-blue-400/30 group-hover:scale-105 transition-transform duration-300">
                            ⚡
                        </div>
                        <div class="absolute -top-1 -right-1 w-3 h-3 bg-emerald-500 rounded-full border-2 border-[#0B0F19]"></div>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="font-display font-black text-2xl sm:text-3xl tracking-tight text-white group-hover:text-blue-400 transition-colors">
                                AUTO<span class="text-amber-400">HUB</span>
                            </span>
                            <span class="bg-blue-950/90 text-blue-300 border border-blue-800/80 text-[10px] font-black px-2 py-0.5 rounded tracking-widest uppercase hidden sm:inline">
                                PRO
                            </span>
                        </div>
                        <span class="block text-[10px] sm:text-[11px] uppercase font-extrabold tracking-widest text-slate-400 -mt-0.5">
                            Motors & Performance Colombia
                        </span>
                    </div>
                </a>

                <!-- Clean Market Identifier & User Account Authentication State -->
                <div class="flex items-center gap-2 sm:gap-3">
                    <div class="hidden md:flex items-center gap-2 text-xs font-semibold text-slate-300 bg-[#111624] px-3 py-1.5 rounded-xl border border-slate-800">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span>🇨🇴 Colombia</span>
                        <span class="text-slate-600">•</span>
                        <span class="text-amber-400 font-mono font-bold">$ COP</span>
                    </div>

                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                        <!-- Logged In User Dropdown / Badge -->
                        <div class="flex items-center gap-1.5 sm:gap-2">
                            <a 
                                href="/perfil" 
                                class="flex items-center gap-2 bg-[#161d31] hover:bg-[#1f2942] border border-blue-500/30 hover:border-blue-400/60 px-3 py-1.5 rounded-xl text-xs font-bold text-white transition group shadow-md shadow-blue-900/20"
                                title="Ver Mi Perfil, Garaje Virtual y Seguridad"
                            >
                                <span class="w-6 h-6 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-xs text-white shrink-0">
                                    <%= currentUser.avatar || '👤' %>
                                </span>
                                <span class="font-extrabold text-blue-200 group-hover:text-white max-w-[110px] sm:max-w-[150px] truncate">
                                    <%= currentUser.name %>
                                </span>
                            </a>

                            <a 
                                href="/logout" 
                                class="p-2 bg-slate-900 hover:bg-red-950/80 border border-slate-800 hover:border-red-500/40 text-slate-400 hover:text-red-400 rounded-xl text-xs font-bold transition"
                                title="Cerrar Sesión"
                            >
                                🚪
                            </a>
                        </div>
                    <% } else { %>
                        <!-- Not Logged In Button -->
                        <a 
                            href="/login" 
                            class="flex items-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-xs font-extrabold px-3.5 sm:px-4 py-2 rounded-xl transition shadow-lg shadow-blue-600/30 border border-blue-400/30 hover:scale-[1.02] active:scale-[0.98]"
                            title="Iniciar Sesión o Crear Cuenta Nueva"
                        >
                            <span>👤</span>
                            <span class="whitespace-nowrap">Ingresar / Registro</span>
                        </a>
                    <% } %>
                </div>

            </div>
        </div>
    </header>

    <!-- FLOATING MASTER COCKPIT DOCK (Navegación, Buscador, Carrito, Opciones & Tasador) -->
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <% 
        const path = typeof currentPath !== 'undefined' ? currentPath : '';
        const isVehicles = path === '/' || path.startsWith('/vehiculos');
        const isParts = path.startsWith('/autopartes');
        const isAppraisal = path.startsWith('/tasador') || path.startsWith('/vender');
        const isArch = path.startsWith('/arquitectura');
        const isCart = path.startsWith('/carrito');
        const isProfile = path.startsWith('/perfil') || path.startsWith('/login') || path.startsWith('/registro');
    %>
    <nav class="fixed bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 z-40 max-w-[96vw] sm:max-w-max mx-auto select-none" aria-label="Consola de Control Flotante">
        <div class="bg-[#0B0F19]/95 backdrop-blur-2xl border border-slate-700/90 shadow-2xl shadow-black/80 rounded-2xl sm:rounded-full p-1.5 sm:p-2 flex items-center justify-center gap-1 sm:gap-2 ring-1 ring-white/10">
            
            <!-- 1. VEHÍCULOS -->
            <a 
                href="/vehiculos" 
                class="flex items-center gap-1.5 px-3 py-2 rounded-xl sm:rounded-full text-xs font-black transition <%= isVehicles && !isParts && !isAppraisal && !isArch && !isCart && !isProfile ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-lg shadow-blue-600/30 border border-blue-400/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
                title="Catálogo de Vehículos Certificados (150 Puntos)"
            >
                <span class="text-sm">🚗</span>
                <span class="hidden md:inline">Vehículos</span>
            </a>

            <!-- 2. AUTOPARTES -->
            <a 
                href="/autopartes" 
                class="flex items-center gap-1.5 px-3 py-2 rounded-xl sm:rounded-full text-xs font-black transition <%= isParts ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-lg shadow-blue-600/30 border border-blue-400/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
                title="Catálogo de Autopartes y Repuestos OEM"
            >
                <span class="text-sm">⚙️</span>
                <span class="hidden md:inline">Autopartes</span>
            </a>

            <!-- 3. BUSCADOR INTERACTIVO (TRIGGERS SEARCH HUD) -->
            <button 
                type="button" 
                onclick="openSearchModal()" 
                class="flex items-center gap-1.5 px-3 py-2 rounded-xl sm:rounded-full text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-800/80 transition group"
                title="Buscador Inteligente de Piezas, Autos o VIN (Atajo: ⌘K o Ctrl+K)"
                id="floatingSearchBtn"
            >
                <span class="text-sm group-hover:scale-110 transition-transform">🔍</span>
                <span class="hidden lg:inline text-slate-300">Buscar</span>
                <span class="hidden xl:inline text-[9px] font-mono text-slate-400 bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700">⌘K</span>
            </button>

            <!-- 4. CARRITO DE COMPRAS -->
            <a 
                href="/carrito" 
                class="flex items-center gap-1.5 px-3 py-2 rounded-xl sm:rounded-full text-xs font-bold transition group relative <%= isCart || cartCount > 0 ? 'bg-blue-600/20 text-blue-300 border border-blue-500/40 hover:bg-blue-600/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
                title="Ver Carrito de Autopartes"
                id="floatingCartBtn"
            >
                <div class="relative">
                    <span class="text-sm group-hover:scale-110 transition-transform inline-block">🛒</span>
                    <% if (cartCount > 0) { %>
                        <span class="absolute -top-1.5 -right-2 bg-gradient-to-r from-blue-500 to-indigo-500 text-white text-[9px] font-black w-4 h-4 rounded-full flex items-center justify-center shadow-md shadow-blue-500/50 border border-blue-300/40 animate-bounce">
                            <%= cartCount %>
                        </span>
                    <% } %>
                </div>
                <span class="hidden sm:inline font-mono font-bold text-xs"><%= cartCount %></span>
            </a>

            <!-- 5. TUERQUITA DE CONFIGURACIÓN & OPCIONES / GARAJE -->
            <button 
                type="button" 
                onclick="openSettingsModal('all')" 
                class="flex items-center gap-1.5 px-3 py-2 rounded-xl sm:rounded-full text-slate-300 hover:text-white hover:bg-slate-800/80 transition text-xs font-bold group"
                title="Centro de Control: Garaje Virtual, Moneda COP y Ubicación"
                id="floatingSettingsBtn"
            >
                <span class="text-sm group-hover:rotate-90 transition-transform duration-300 inline-block">⚙️</span>
                <span class="hidden lg:inline text-xs">Opciones</span>
                <span class="hidden md:inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            </button>

            <!-- 6. USUARIO / MI CUENTA O LOGIN -->
            <a 
                href="<%= typeof currentUser !== 'undefined' && currentUser ? '/perfil' : '/login' %>" 
                class="flex items-center gap-1.5 px-3 py-2 rounded-xl sm:rounded-full text-xs font-bold transition group <%= isProfile ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30 border border-blue-400/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/80' %>"
                title="<%= typeof currentUser !== 'undefined' && currentUser ? 'Mi Cuenta AutoHub' : 'Iniciar Sesión o Registro' %>"
                id="floatingAccountBtn"
            >
                <span class="text-sm"><%= typeof currentUser !== 'undefined' && currentUser ? (currentUser.avatar || '👤') : '👤' %></span>
                <span class="hidden lg:inline"><%= typeof currentUser !== 'undefined' && currentUser ? currentUser.name.split(' ')[0] : 'Ingresar' %></span>
            </a>

            <!-- DIVIDER -->
            <div class="h-5 w-[1px] bg-slate-700/80 mx-0.5 hidden sm:block"></div>

            <!-- 7. TASADOR / VENDER AUTO (IGNITION BUTTON) -->
            <a 
                href="/tasador" 
                class="flex items-center gap-1.5 px-3.5 sm:px-4 py-2 rounded-xl sm:rounded-full bg-gradient-to-r from-amber-500 via-amber-600 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-slate-950 text-xs font-black uppercase tracking-wider transition-all shadow-lg shadow-amber-500/30 border border-amber-300/40 hover:scale-[1.03] active:scale-[0.98] whitespace-nowrap"
                title="Tasar tu auto al instante con valuador IA oficial"
            >
                <span>⚡</span>
                <span class="hidden xs:inline sm:inline">Tasar Auto</span>
            </a>

        </div>
    </nav>
    <% } %>

    <!-- SEARCH HUD MODAL (FULL SCREEN COCKPIT SEARCH) -->
    <div id="searchModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden flex items-start justify-center p-4 sm:p-6 overflow-y-auto animate-fadeIn">
        <div class="bg-[#0F1422] rounded-3xl max-w-2xl w-full shadow-2xl border border-slate-700/90 overflow-hidden relative my-8 sm:my-16 text-slate-200">
            
            <!-- Search Input Header -->
            <div class="p-4 sm:p-6 border-b border-slate-800 bg-[#111624]">
                <div class="flex items-center justify-between pb-3 text-xs text-slate-400">
                    <span class="font-extrabold uppercase tracking-wider text-blue-400 flex items-center gap-1.5">
                        <span>🔍</span> Buscador Universal AutoHub
                    </span>
                    <button type="button" onclick="closeSearchModal()" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-sm transition">
                        ✕
                    </button>
                </div>

                <form action="/autopartes" method="GET" class="relative">
                    <input 
                        type="text" 
                        name="search" 
                        id="modalSearchInput"
                        placeholder="Buscar por repuesto, código OEM, modelo o VIN RUNT..." 
                        autocomplete="off"
                        class="w-full bg-[#182035] border border-slate-700 text-slate-100 placeholder-slate-400 rounded-2xl pl-11 pr-20 py-3.5 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-inner"
                    >
                    <span class="absolute left-4 top-4 text-slate-400 text-base">🔍</span>
                    <button 
                        type="submit" 
                        class="absolute right-3 top-2.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-xl transition shadow-md"
                    >
                        Buscar
                    </button>
                </form>
            </div>

            <!-- Modal Content Shortcuts & Active Garage -->
            <div class="p-6 space-y-5 text-xs">
                
                <!-- Active Vehicle Quick Match -->
                <div class="p-4 rounded-2xl bg-gradient-to-r from-amber-500/15 to-blue-500/15 border border-amber-500/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">🚗</span>
                        <div>
                            <span class="text-[10px] text-amber-400 font-bold uppercase tracking-wider block">Tu Garaje Activo</span>
                            <span class="font-black text-sm text-white block">
                                <%= garageVehicle.make %> <%= garageVehicle.model %> (<%= garageVehicle.year %>)
                            </span>
                            <span class="text-[11px] text-slate-400">Placa: <%= garageVehicle.plate || 'KLU-842' %> • Liquidación oficial en COP</span>
                        </div>
                    </div>
                    <a 
                        href="/autopartes?search=<%= encodeURIComponent(garageVehicle.make) %>" 
                        class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs transition shadow-md whitespace-nowrap"
                    >
                        Ver Piezas Compatibles &rarr;
                    </a>
                </div>

                <!-- Popular Categories Grid -->
                <div>
                    <h4 class="font-bold text-slate-400 uppercase tracking-wider text-[11px] mb-3">Categorías Frecuentes</h4>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                        <a href="/autopartes?category=Frenos" class="p-3 rounded-xl bg-slate-900/80 hover:bg-slate-800 hover:text-white border border-slate-800 flex items-center gap-2 transition">
                            <span class="text-base">🛑</span>
                            <div>
                                <span class="font-bold text-slate-200 block text-xs">Frenos & Pastillas</span>
                                <span class="text-[10px] text-slate-400">Discos cerámicos</span>
                            </div>
                        </a>
                        <a href="/autopartes?category=Motor" class="p-3 rounded-xl bg-slate-900/80 hover:bg-slate-800 hover:text-white border border-slate-800 flex items-center gap-2 transition">
                            <span class="text-base">🔧</span>
                            <div>
                                <span class="font-bold text-slate-200 block text-xs">Motor & Filtros</span>
                                <span class="text-[10px] text-slate-400">Aceites y correas</span>
                            </div>
                        </a>
                        <a href="/autopartes?category=Suspensión" class="p-3 rounded-xl bg-slate-900/80 hover:bg-slate-800 hover:text-white border border-slate-800 flex items-center gap-2 transition">
                            <span class="text-base">🔄</span>
                            <div>
                                <span class="font-bold text-slate-200 block text-xs">Suspensión</span>
                                <span class="text-[10px] text-slate-400">Amortiguadores</span>
                            </div>
                        </a>
                        <a href="/vehiculos" class="p-3 rounded-xl bg-slate-900/80 hover:bg-slate-800 hover:text-white border border-slate-800 flex items-center gap-2 transition">
                            <span class="text-base">🏎️</span>
                            <div>
                                <span class="font-bold text-slate-200 block text-xs">Vehículos 360°</span>
                                <span class="text-[10px] text-slate-400">150 Puntos peritaje</span>
                            </div>
                        </a>
                        <a href="/tasador" class="p-3 rounded-xl bg-slate-900/80 hover:bg-slate-800 hover:text-white border border-slate-800 flex items-center gap-2 transition">
                            <span class="text-base">📊</span>
                            <div>
                                <span class="font-bold text-slate-200 block text-xs">Tasador IA</span>
                                <span class="text-[10px] text-slate-400">Vender mi carro</span>
                            </div>
                        </a>
                        <a href="/arquitectura" class="p-3 rounded-xl bg-slate-900/80 hover:bg-slate-800 hover:text-white border border-slate-800 flex items-center gap-2 transition">
                            <span class="text-base">📐</span>
                            <div>
                                <span class="font-bold text-slate-200 block text-xs">Esquema DB</span>
                                <span class="text-[10px] text-slate-400">Diagrama SQL</span>
                            </div>
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- FLASH MESSAGES -->
    <% if (flash) { %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="p-4 rounded-2xl flex items-center justify-between text-sm font-semibold <%= flash.type === 'error' ? 'bg-red-50 text-red-800 border border-red-200' : 'bg-emerald-50 text-emerald-800 border border-emerald-200' %>">
                <div class="flex items-center gap-2">
                    <span><%= flash.type === 'error' ? '⚠️' : '✓' %></span>
                    <span><%= flash.message %></span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-700">✕</button>
            </div>
        </div>
    <% } %>

    <!-- REDESIGNED CENTRAL OPTIONS & SETTINGS MODAL -->
    <div id="settingsModal" class="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-md hidden flex items-center justify-center p-4 sm:p-6 overflow-y-auto">
        <div class="bg-white rounded-3xl max-w-2xl w-full shadow-2xl border border-slate-200 overflow-hidden relative animate-scaleUp my-8">
            
            <!-- Modal Header -->
            <div class="bg-slate-900 text-white p-6 sm:p-7 flex items-center justify-between border-b border-slate-800">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-600 to-amber-500 text-white flex items-center justify-center text-xl shadow-lg shadow-brand-600/30 font-black">
                        ⚙️
                    </div>
                    <div>
                        <h3 class="font-display font-black text-xl sm:text-2xl text-white">Centro de Opciones & Configuración</h3>
                        <p class="text-xs text-slate-400">Personaliza tu experiencia de compra, garaje activo y moneda nacional.</p>
                    </div>
                </div>
                <button type="button" onclick="closeSettingsModal()" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-base transition">
                    ✕
                </button>
            </div>

            <!-- Tab Switcher Navigation -->
            <div class="bg-slate-100 px-6 pt-3 border-b border-slate-200 flex gap-2 overflow-x-auto">
                <button 
                    type="button" 
                    id="tabBtnGarage"
                    onclick="switchSettingsTab('garage')" 
                    class="px-4 py-2.5 text-xs font-black rounded-t-xl transition border-b-2 border-brand-600 bg-white text-brand-700 shadow-sm flex items-center gap-2 whitespace-nowrap"
                >
                    <span>🚗</span> Mi Garaje Virtual
                </button>
                <button 
                    type="button" 
                    id="tabBtnRegional"
                    onclick="switchSettingsTab('regional')" 
                    class="px-4 py-2.5 text-xs font-bold rounded-t-xl transition border-b-2 border-transparent text-slate-600 hover:text-slate-900 flex items-center gap-2 whitespace-nowrap"
                >
                    <span>🇨🇴</span> Moneda & Ubicación
                </button>
                <button 
                    type="button" 
                    id="tabBtnServices"
                    onclick="switchSettingsTab('services')" 
                    class="px-4 py-2.5 text-xs font-bold rounded-t-xl transition border-b-2 border-transparent text-slate-600 hover:text-slate-900 flex items-center gap-2 whitespace-nowrap"
                >
                    <span>🛠️</span> Servicios & Talleres
                </button>
            </div>

            <!-- Modal Form Content -->
            <form action="/api/settings/save" method="POST" class="p-6 sm:p-8 space-y-6">
                
                <!-- TAB 1: MI GARAJE VIRTUAL -->
                <div id="settingsTabGarage" class="space-y-5">
                    
                    <!-- Current Active Vehicle Badge -->
                    <div class="bg-gradient-to-r from-slate-900 to-brand-950 p-4 rounded-2xl text-white flex items-center justify-between border border-slate-800">
                        <div class="flex items-center gap-3">
                            <span class="text-2xl">🚘</span>
                            <div>
                                <span class="text-[10px] text-amber-400 font-bold uppercase tracking-wider block">Vehículo Actualmente Activo</span>
                                <h4 class="font-display font-black text-base text-white">
                                    <%= garageVehicle.make %> <%= garageVehicle.model %> (<%= garageVehicle.year %>)
                                </h4>
                                <span class="text-xs text-slate-400">Motor: <%= garageVehicle.engine %> • Placa: <%= garageVehicle.plate || 'KLU-842' %></span>
                            </div>
                        </div>
                        <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px] font-black px-2.5 py-1 rounded-full uppercase">
                            ✓ Filtro ACES Activo
                        </span>
                    </div>

                    <p class="text-xs text-slate-600">
                        Configura el vehículo de tu propiedad para que el catálogo de repuestos valide el ajuste (fitment) exacto en tiempo real.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-black text-slate-600 uppercase mb-1.5">Marca del Auto</label>
