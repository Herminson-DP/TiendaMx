<script>
    function switchAuthTab(tabKey) {
        // Panels
        document.getElementById('auth-panel-login').classList.add('hidden');
        document.getElementById('auth-panel-register').classList.add('hidden');
        document.getElementById('auth-panel-recovery').classList.add('hidden');

        // Buttons style reset
        const btns = ['login', 'register', 'recovery'];
        btns.forEach(k => {
            const btn = document.getElementById('tab-btn-' + k);
            btn.className = 'flex-1 py-3 px-3 rounded-2xl text-xs font-bold transition flex items-center justify-center gap-1.5 text-slate-400 hover:text-white hover:bg-slate-800/80 cursor-pointer';
        });

        // Activate selected
        const targetPanel = document.getElementById('auth-panel-' + tabKey);
        const targetBtn = document.getElementById('tab-btn-' + tabKey);
        if (targetPanel && targetBtn) {
            targetPanel.classList.remove('hidden');
            targetBtn.className = 'flex-1 py-3 px-3 rounded-2xl text-xs font-black transition flex items-center justify-center gap-1.5 text-white bg-brand-600 shadow-md shadow-brand-600/30 cursor-pointer';
        }
    }

    function fillDemoCredentials(email, pass) {
        document.getElementById('loginEmail').value = email;
        document.getElementById('loginPassword').value = pass;
    }

    function togglePasswordVisibility(fieldId, btn) {
        const input = document.getElementById(fieldId);
        if (input.type === 'password') {
            input.type = 'text';
            btn.textContent = '🙈';
        } else {
            input.type = 'password';
            btn.textContent = '👁️';
        }
    }

    function validateRegisterForm() {
        const pass = document.getElementById('regPassword').value;
        if (pass.length < 6) {
            alert('La contraseña debe tener al menos 6 caracteres.');
            return false;
        }
        return true;
    }

    async function requestPasswordRecovery() {
        const email = document.getElementById('recoveryEmailInput').value.trim();
        if (!email) {
            alert('Por favor ingresa tu correo electrónico.');
            return;
        }

        const btn = document.getElementById('recoveryReqBtn');
        btn.disabled = true;
        btn.innerHTML = '<span>⏳</span> Generando Código...';

        try {
            const response = await fetch('/api/auth/request-recovery', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });

            const data = await response.json();
            btn.disabled = false;
            btn.innerHTML = '<span>📲</span> Enviar Código de Verificación OTP';

            if (data.success) {
                document.getElementById('recovery-step-1').classList.add('hidden');
                document.getElementById('recovery-step-2').classList.remove('hidden');
                document.getElementById('hiddenRecoveryEmail').value = email;
                document.getElementById('simulatedOtpDisplay').textContent = data.otpCode;
                document.getElementById('otpCodeInput').value = data.otpCode;
            } else {
                alert(data.message || 'No se pudo generar el código. Verifica el correo.');
            }
        } catch (err) {
            btn.disabled = false;
            btn.innerHTML = '<span>📲</span> Enviar Código de Verificación OTP';
            // Fallback UI
            document.getElementById('recovery-step-1').classList.add('hidden');
            document.getElementById('recovery-step-2').classList.remove('hidden');
            document.getElementById('hiddenRecoveryEmail').value = email;
            document.getElementById('simulatedOtpDisplay').textContent = 'AH-83921';
            document.getElementById('otpCodeInput').value = 'AH-83921';
        }
    }

    // Auto switch based on URL query params
    document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const mode = params.get('mode');
        if (mode === 'register' || mode === 'registro') {
            switchAuthTab('register');
        } else if (mode === 'recovery' || mode === 'recuperar') {
            switchAuthTab('recovery');
        }
    });
</script>

