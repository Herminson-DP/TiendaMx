<%- include('header') %>

<div class="receipt-wrapper">
    <!-- Header with Success Animation Badge -->
    <div class="receipt-header">
        <div class="success-icon-badge">✓</div>
        <h2>¡Gracias por tu Compra!</h2>
        <p style="color: var(--text-muted); font-size: 1rem; margin-top: 6px;">
            Tu pedido <strong>#<%= order.id %></strong> ha sido registrado y procesado exitosamente.
        </p>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
            Hemos enviado una copia del comprobante a <strong><%= order.customer.email %></strong>.
        </p>
    </div>

    <!-- Order Tracking Timeline -->
    <div class="tracking-stepper">
        <div class="tracking-step done">
            <div class="step-icon">✓</div>
            <div class="step-label">Confirmado</div>
        </div>
        <div class="tracking-step <%= (order.status === 'Preparando' || order.status === 'Enviado' || order.status === 'Entregado') ? 'done' : 'active' %>">
            <div class="step-icon">📦</div>
            <div class="step-label">En Preparación</div>
        </div>
        <div class="tracking-step <%= (order.status === 'Enviado' || order.status === 'Entregado') ? 'done' : '' %>">
            <div class="step-icon">🚚</div>
            <div class="step-label">En Camino</div>
        </div>
        <div class="tracking-step <%= order.status === 'Entregado' ? 'done' : '' %>">
            <div class="step-icon">🏠</div>
            <div class="step-label">Entregado</div>
        </div>
    </div>

    <!-- Order Meta Details Grid -->
    <div class="grid-2" style="background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 28px;">
        <div>
            <span style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Información de Envío</span>
            <h4 style="margin: 4px 0;"><%= order.customer.name %></h4>
            <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.5;">
                <%= order.customer.address %><br>
                Tel: <%= order.customer.phone || 'N/A' %><br>
                Email: <%= order.customer.email %>
            </p>
        </div>
        <div>
            <span style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Detalles de la Orden</span>
            <div style="font-size: 0.88rem; margin-top: 4px; line-height: 1.6;">
                <div><strong>Fecha:</strong> <%= order.date %></div>
                <div><strong>Método de Pago:</strong> <%= order.paymentMethod || 'Tarjeta de Crédito' %></div>
                <div><strong>Servicio de Envío:</strong> <%= order.shippingMethod || 'Estándar' %></div>
                <div><strong>No. de Guía:</strong> <span style="font-family: monospace; color: var(--primary); font-weight: 700;"><%= order.trackingNumber || 'SERVI-88291024CO' %></span></div>
            </div>
        </div>
    </div>

    <!-- Items Table -->
    <h3 style="margin-bottom: 14px; font-size: 1.15rem;">Artículos Comprados</h3>
    <table class="custom-table" style="margin-bottom: 24px;">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cant.</th>
                <th>Precio Unit.</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            <% order.items.forEach(item => { %>
                <tr>
                    <td>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <img src="<%= item.product.image %>" alt="<%= item.product.name %>" style="width: 44px; height: 44px; border-radius: 6px; object-fit: cover;">
                            <div>
                                <strong><%= item.product.name %></strong>
                                <div style="font-size: 0.78rem; color: var(--text-muted);"><%= item.product.category %></div>
                            </div>
                        </div>
                    </td>
                    <td><%= item.quantity %></td>
                    <td><%= formatMoney(item.unit_price) %></td>
                    <td><strong><%= formatMoney(item.total) %></strong></td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <!-- Totals Breakdown -->
    <div style="max-width: 320px; margin-left: auto; margin-bottom: 32px;">
        <div class="summary-row">
            <span>Subtotal:</span>
            <span><%= formatMoney(order.subtotal || order.total) %></span>
        </div>
        <% if (order.discountAmount && order.discountAmount > 0) { %>
            <div class="summary-row" style="color: #059669; font-weight: 600;">
                <span>Descuento (<%= order.couponCode %>):</span>
                <span>-<%= formatMoney(order.discountAmount) %></span>
            </div>
        <% } %>
        <div class="summary-row">
            <span>IVA (<%= config.tax || 19 %>%):</span>
            <span><%= formatMoney(order.tax || 0) %></span>
        </div>
        <div class="summary-row">
            <span>Envío:</span>
            <span><%= Number(order.shipping || 0) === 0 ? 'GRATIS' : formatMoney(order.shipping) %></span>
        </div>
        <div class="summary-row summary-total">
            <span>Total Pagado:</span>
            <span style="color: var(--primary);"><%= formatMoney(order.total) %> COP</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="flex-between" style="border-top: 1px solid var(--border); padding-top: 24px; flex-wrap: wrap; gap: 12px;">
        <button type="button" onclick="window.print()" class="btn btn-secondary">
            🖨️ Imprimir Comprobante
        </button>
        <div class="flex-gap">
            <a href="/index.php?action=orders" class="btn btn-secondary">
                Ver Mis Pedidos
            </a>
            <a href="/index.php" class="btn btn-primary">
                Volver a la Tienda
            </a>
        </div>
    </div>
</div>

<%- include('footer') %>
