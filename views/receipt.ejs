<%- include('header') %>

<div class="receipt-wrapper" id="receiptCard">
    <!-- Receipt Header -->
    <div class="receipt-header">
        <div class="success-icon-badge">✓</div>
        <h2>¡Gracias por tu compra en <%= config.store_name || 'Tienda Colombia' %>!</h2>
        <p style="color: var(--text-muted); font-size: 1.05rem; margin-top: 6px;">
            Tu orden <strong style="color: var(--primary);">#<%= order.id %></strong> ha sido confirmada y recibida con éxito.
        </p>
        <p style="font-size: 0.88rem; color: #64748b; margin-top: 4px;">
            Hemos enviado una copia del recibo y detalles de entrega a <strong><%= order.customer.email %></strong>.
        </p>
    </div>

    <!-- Tracking Stepper -->
    <% 
        const status = order.status || 'Confirmado';
        let step1Class = 'done';
        let step2Class = (status === 'Preparando' || status === 'Enviado' || status === 'Entregado') ? 'done' : 'active';
        let step3Class = (status === 'Enviado' || status === 'Entregado') ? 'done' : (status === 'Preparando' ? 'active' : '');
        let step4Class = (status === 'Entregado') ? 'done' : (status === 'Enviado' ? 'active' : '');
    %>
    <div class="tracking-stepper" aria-label="Progreso del pedido">
        <div class="tracking-step <%= step1Class %>">
            <div class="step-icon">✓</div>
            <span class="step-label">Confirmado</span>
        </div>
        <div class="tracking-step <%= step2Class %>">
            <div class="step-icon">📦</div>
            <span class="step-label">Preparando</span>
        </div>
        <div class="tracking-step <%= step3Class %>">
            <div class="step-icon">🚚</div>
            <span class="step-label">En Camino</span>
        </div>
        <div class="tracking-step <%= step4Class %>">
            <div class="step-icon">🏠</div>
            <span class="step-label">Entregado</span>
        </div>
    </div>

    <!-- Order Summary Grid Info -->
    <div style="background: #f8fafc; border-radius: 16px; border: 1.5px solid var(--border); padding: 24px; margin-bottom: 32px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
            <div>
                <span style="font-size: 0.78rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase;">Número de Orden:</span>
                <p style="font-size: 1.05rem; font-weight: 800; color: var(--primary); margin-top: 2px;"><%= order.id %></p>
            </div>
            <div>
                <span style="font-size: 0.78rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase;">Fecha y Hora:</span>
                <p style="font-size: 0.95rem; font-weight: 600; color: var(--secondary); margin-top: 2px;"><%= order.date %></p>
            </div>
            <div>
                <span style="font-size: 0.78rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase;">Guía de Rastreo Nacional:</span>
                <p style="font-size: 0.95rem; font-weight: 700; color: #059669; margin-top: 2px;"><%= order.trackingNumber || 'SERVI-PENDIENTE' %></p>
            </div>
            <div>
                <span style="font-size: 0.78rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase;">Método de Pago:</span>
                <p style="font-size: 0.95rem; font-weight: 700; color: var(--secondary); margin-top: 2px;"><%= order.paymentMethod || 'PSE' %></p>
            </div>
        </div>
    </div>

    <!-- Customer Details -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
        <div style="background: white; border: 1.5px solid var(--border); border-radius: 12px; padding: 20px;">
            <h4 style="font-size: 0.95rem; margin-bottom: 12px; color: var(--secondary);">📍 Datos de Entrega</h4>
            <p style="font-size: 0.9rem; margin-bottom: 4px;"><strong>Destinatario:</strong> <%= order.customer.name %></p>
            <p style="font-size: 0.9rem; margin-bottom: 4px;"><strong>Dirección:</strong> <%= order.customer.address %></p>
            <p style="font-size: 0.9rem; margin-bottom: 4px;"><strong>Celular:</strong> <%= order.customer.phone %></p>
            <% if (order.customer.notes) { %>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 8px;"><strong>Notas:</strong> <%= order.customer.notes %></p>
            <% } %>
        </div>

        <div style="background: white; border: 1.5px solid var(--border); border-radius: 12px; padding: 20px;">
            <h4 style="font-size: 0.95rem; margin-bottom: 12px; color: var(--secondary);">🚚 Método de Transporte</h4>
            <p style="font-size: 0.9rem; margin-bottom: 6px;"><strong>Servicio:</strong> <%= order.shippingMethod || 'Estándar Colombia' %></p>
            <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">
                El transportador realizará hasta 2 intentos de entrega en la dirección indicada. Puedes verificar el estado en tiempo real en nuestra sección de pedidos.
            </p>
        </div>
    </div>

    <!-- Purchased Products Table -->
    <h4 style="font-size: 1.1rem; margin-bottom: 16px;">Artículos Comprados</h4>
    <div class="table-responsive" style="margin-bottom: 28px;">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cant.</th>
                    <th>Precio Unitario</th>
                    <th style="text-align: right;">Total</th>
                </tr>
            </thead>
            <tbody>
                <% order.items.forEach(item => { %>
                    <tr>
                        <td>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <img 
                                    src="<%= item.product.image %>" 
                                    alt="<%= item.product.name %>" 
                                    style="width: 46px; height: 46px; border-radius: 8px; object-fit: cover;"
                                    onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=60'"
                                >
                                <div>
                                    <strong><%= item.product.name %></strong>
                                    <div style="font-size: 0.78rem; color: var(--text-muted);"><%= item.product.category %></div>
                                </div>
                            </div>
                        </td>
                        <td><strong><%= item.quantity %></strong></td>
                        <td><%= formatMoney(item.unit_price) %></td>
                        <td style="text-align: right;"><strong><%= formatMoney(item.total) %></strong></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <!-- Financial Breakdown -->
    <div style="max-width: 360px; margin-left: auto; margin-bottom: 36px;">
        <div class="summary-row">
            <span>Subtotal:</span>
            <span><%= formatMoney(order.subtotal) %></span>
        </div>
        <% if (order.discountAmount > 0) { %>
            <div class="summary-row" style="color: #059669; font-weight: 700;">
                <span>Descuento (<%= order.couponCode %>):</span>
                <span>-<%= formatMoney(order.discountAmount) %></span>
            </div>
        <% } %>
        <div class="summary-row">
            <span>Impuestos IVA (<%= config.tax || 19 %>%):</span>
            <span><%= formatMoney(order.tax) %></span>
        </div>
        <div class="summary-row">
            <span>Costo de Envío:</span>
            <span><%= order.shipping === 0 ? 'GRATIS' : formatMoney(order.shipping) %></span>
        </div>
        <div class="summary-row summary-total">
            <span>Total Pagado:</span>
            <span style="color: var(--primary);"><%= formatMoney(order.total) %> COP</span>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex-between" style="flex-wrap: wrap; gap: 14px; border-top: 1.5px solid var(--border); padding-top: 24px;">
        <button type="button" class="btn btn-secondary" onclick="window.print()">
            🖨️ Imprimir Recibo
        </button>
        <div class="flex-gap">
            <a href="/index.php?action=orders" class="btn btn-secondary">
                📦 Ver Mis Pedidos
            </a>
            <a href="/index.php" class="btn btn-primary">
                🛍️ Seguir Comprando
            </a>
        </div>
    </div>
</div>

<%- include('footer') %>
