<%- include('header') %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-xl text-center space-y-6">
        
        <div class="w-16 h-16 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center text-3xl mx-auto">
            ✓
        </div>

        <div>
            <span class="text-xs font-black uppercase text-emerald-600 tracking-wider">Pago Procesado con Éxito</span>
            <h1 class="font-display text-3xl font-black text-slate-900 mt-1">¡Gracias por tu Compra en AutoHub!</h1>
            <p class="text-xs text-slate-500 mt-1">Tu orden de autopartes está siendo preparada en nuestro centro logístico.</p>
        </div>

        <!-- Receipt Box -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 text-left space-y-4 text-xs">
            <div class="flex justify-between items-center pb-3 border-b border-slate-200">
                <div>
                    <span class="text-slate-400 font-bold block">Número de Orden</span>
                    <span class="font-mono font-black text-base text-slate-900"><%= order.id %></span>
                </div>
                <div class="text-right">
                    <span class="text-slate-400 font-bold block">Guía de Rastreo</span>
                    <span class="font-mono font-black text-xs text-brand-600"><%= order.trackingNumber %></span>
                </div>
            </div>

            <!-- Items -->
            <div class="space-y-2">
                <span class="text-slate-400 font-bold block">Repuestos Comprados</span>
                <% order.items.forEach(item => { %>
                    <div class="flex justify-between py-1.5 border-b border-slate-100 last:border-0">
                        <div>
                            <span class="font-bold text-slate-800"><%= item.part.name %></span>
                            <span class="text-[10px] text-slate-400 block">Cant: <%= item.quantity %> • SKU: <%= item.part.sku %></span>
                        </div>
                        <span class="font-black text-slate-900"><%= formatCOP(item.totalCOP) %></span>
                    </div>
                <% }); %>
            </div>

            <div class="pt-3 border-t border-slate-200 flex justify-between items-baseline">
                <span class="font-black text-slate-900 text-sm">Total Pagado (<%= order.paymentMethod %>)</span>
                <span class="font-black text-emerald-600 text-lg"><%= formatCOP(order.total) %></span>
            </div>

            <% if (order.payment_details) { %>
                <!-- Detailed Bank / Gateway Breakdown -->
                <div class="p-3 bg-white rounded-xl border border-slate-200 space-y-1.5 text-[11px]">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-slate-800 flex items-center gap-1.5">
                            <span>🏛️</span> <%= order.payment_details.type %>
                        </span>
                        <% if (order.payment_details.authCode) { %>
                            <span class="bg-emerald-100 text-emerald-800 font-mono font-bold px-2 py-0.5 rounded text-[10px]">
                                <%= order.payment_details.authCode %>
                            </span>
                        <% } %>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-slate-600 pt-1 border-t border-slate-100 text-[10px]">
                        <% if (order.payment_details.bankName) { %>
                            <div>Banco: <strong class="text-slate-900"><%= order.payment_details.bankName %></strong></div>
                        <% } %>
                        <% if (order.payment_details.docNumber) { %>
                            <div>Documento: <strong class="text-slate-900"><%= order.payment_details.docType || 'CC' %> <%= order.payment_details.docNumber %></strong></div>
                        <% } %>
                        <% if (order.payment_details.transactionRef) { %>
                            <div>Ref: <strong class="text-slate-900 font-mono"><%= order.payment_details.transactionRef %></strong></div>
                        <% } %>
                        <% if (order.payment_details.walletPhone) { %>
                            <div>Billetera: <strong class="text-purple-700 font-mono"><%= order.payment_details.walletName %> (<%= order.payment_details.walletPhone %>)</strong></div>
                        <% } %>
                        <% if (order.payment_details.maskedCard) { %>
                            <div>Tarjeta: <strong class="text-slate-900 font-mono"><%= order.payment_details.maskedCard %></strong></div>
                            <div>Diferido: <strong class="text-slate-900"><%= order.payment_details.installments %> cuota(s)</strong></div>
                        <% } %>
                        <% if (order.payment_details.transferRef) { %>
                            <div>Comprobante: <strong class="text-slate-900 font-mono"><%= order.payment_details.transferRef %></strong></div>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <div class="pt-2 text-slate-600">
                <span class="text-slate-400 font-bold block">Destino de Entrega</span>
                <p class="font-semibold"><%= order.customer.name %> • <%= order.customer.address %></p>
                <% if (order.customer.partnerShopInstall) { %>
                    <span class="inline-block mt-1 px-2 py-0.5 bg-brand-100 text-brand-800 rounded font-bold text-[10px]">
                        🛠️ Incluye Servicio de Instalación en Taller Aliado
                    </span>
                <% } %>
            </div>
        </div>

        <div class="flex items-center justify-center gap-4 pt-4">
            <a href="/autopartes" class="px-5 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-bold text-slate-700 transition">
                Seguir Comprando Repuestos
            </a>
            <a href="/" class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-black text-white transition shadow-md">
                Ir al Inicio
            </a>
        </div>

    </div>
</div>

<%- include('footer') %>
